' === 日冲决策建议函数 ===
Public Function 日冲建议(ByVal sDXEF As String, ByVal sDXCD As String, ByVal sDXAB As String) As String
    ' 返回：可操作 / 谨慎 / 禁止 / 无数据
    Dim pZE As Double, pZC As Double, pZA As Double, pDSHA1 As Double
    Dim 小样本标记 As String
    If Not 日冲评分(sDXEF, sDXCD, sDXAB, pZE, pZC, pZA, pDSHA1, 小样本标记) Then
        日冲建议 = 无数据: Exit Function
    End If
    If 小样本标记 <>  Then")
print("        日冲建议 = ""无数据"": Exit Function")
print("    End If")
print("    ' 决策规则：")
print("    ' →ZE>0 >= 90% 且 →ZE+ZC+ZA >= 30% → 可操作")
print("    ' →ZE>0 >= 70% 且 →ZE+ZC+ZA >= 10% → 谨慎")
print("    ' 其他 → 禁止")
print("    If pZE >= 90 And pZA >= 30 Then")
print("        日冲建议 = ""可操作
    ElseIf pZE >= 70 And pZA >= 10 Then
        日冲建议 = 谨慎
    Else
        日冲建议 = 禁止
    End If
End Function
