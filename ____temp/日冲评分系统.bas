' ===== 核心函数1：日冲三指标 =====
' 输入：DXEF(金/银/嘘/唏/屎/尿), DXCD(上/中/下/忐/忠/忑), DXAB(上/中/下/忐/忠/忑)
' 输出：pZA(→ZE+ZC+ZA), pDSHA1(下日DSHA>1), 小样本标记
' 返回值：True=找到匹配
Public Function 日冲三指标(ByVal sDXEF As String, ByVal sDXCD As String, ByVal sDXAB As String, _
    ByRef pZA As Double, ByRef pDSHA1 As Double, ByRef 小样本标记 As String) As Boolean

    ' 映射DXEF
    Dim iEF As Long
    Select Case sDXEF
        Case "金": iEF = 0
        Case "银": iEF = 1
        Case "嘘": iEF = 2
        Case "唏": iEF = 3
        Case "屎": iEF = 4
        Case "尿": iEF = 5
        Case Else: 日冲三指标 = False: Exit Function
    End Select

    ' 映射DXCD
    Dim iCD As Long
    Select Case sDXCD
        Case "上": iCD = 0
        Case "中": iCD = 1
        Case "下": iCD = 2
        Case "忐": iCD = 3
        Case "忠": iCD = 4
        Case "忑": iCD = 5
        Case Else: 日冲三指标 = False: Exit Function
    End Select

    ' 映射DXAB
    Dim iAB As Long
    Select Case sDXAB
        Case "上": iAB = 0
        Case "中": iAB = 1
        Case "下": iAB = 2
        Case "忐": iAB = 3
        Case "忠": iAB = 4
        Case "忑": iAB = 5
        Case Else: 日冲三指标 = False: Exit Function
    End Select

    ' 查概率表
    Dim arrData As Variant
    arrData = 取概率数据(iEF)
    Dim rowData As Variant
    rowData = arrData(iCD)(iAB)

    ' 提取三个核心指标
    pZA = rowData(3)       ' →ZE>0+ZC>0+ZA>0
    pDSHA1 = rowData(4)    ' 下日DSHA>1
    If rowData(5) = 1 Then
        小样本标记 = "小样本"
    Else
        小样本标记 = ""
    End If

    日冲三指标 = (rowData(0) > 0)
End Function


' ===== 核心函数2：日冲综合评分 =====
' 权重设计：均HR × 0.5 + 下日DSHA>3 × 0.3 + →ZE+ZC+ZA × 0.2
' 理由：均HR直接衡量冲高幅度，DSHA>3衡量大幅冲高概率，→ZE+ZC+ZA做安全兜底
' 范围：0~100
Public Function 日冲综合评分(ByVal sDXEF As String, ByVal sDXCD As String, ByVal sDXAB As String, _
    Optional ByVal 管宽 As Double = -1) As Double

    ' 第一步：查三指标
    Dim pZA As Double, pDSHA1 As Double, 小样本标记 As String
    If Not 日冲三指标(sDXEF, sDXCD, sDXAB, pZA, pDSHA1, 小样本标记) Then
        日冲综合评分 = 0: Exit Function
    End If

    ' 小样本：不评分
    If 小样本标记 <> "" Then
        日冲综合评分 = 0: Exit Function
    End If

    ' 第二步：战场过滤（只保留金/银/唏）
    If sDXEF <> "金" And sDXEF <> "银" And sDXEF <> "唏" Then
        ' 嘘/屎/尿：即使有概率也不能做，降权到0
        日冲综合评分 = 0: Exit Function
    End If

    ' 第三步：计算基础分
    ' 从概率表取均HR近似值（用→ZE+ZC+ZA和DSHA>1估算）
    ' 均HR 2.31% = 满分50, 均HR 0% = 0分
    ' pZA 100% = 满分20, pZA 0% = 0分
    ' DSHA>1 100% = 满分30, DSHA>1 0% = 0分
    Dim 基础分 As Double
    基础分 = pZA * 0.2 + pDSHA1 * 0.3

    ' 第四步：管宽加分
    If 管宽 >= 0 Then
        If 管宽 > 10 Then
            基础分 = 基础分 + 10  ' 管宽>10，加分
        ElseIf 管宽 > 5 Then
            基础分 = 基础分 + 5
        End If
    End If

    ' 第五步：DXCD加分（上/忐=强势，加分）
    Select Case sDXCD
        Case "上", "忐": 基础分 = 基础分 + 5
        Case "中", "忠": 基础分 = 基础分 + 0
        Case "下", "忑": 基础分 = 基础分 - 5
    End Select

    日冲综合评分 = Application.Max(0, Application.Min(100, 基础分))
End Function


' ===== 核心函数3：日冲过滤（完整决策链） =====
' 输入：当前行的DXEF/DXCD/DXAB + 管宽
' 输出：建议文字
Public Function 日冲过滤(ByVal sDXEF As String, ByVal sDXCD As String, ByVal sDXAB As String, _
    Optional ByVal 管宽 As Double = -1, Optional ByVal 柱排 As String = "") As String

    ' 查三指标
    Dim pZA As Double, pDSHA1 As Double, 小样本标记 As String
    If Not 日冲三指标(sDXEF, sDXCD, sDXAB, pZA, pDSHA1, 小样本标记) Then
        日冲过滤 = "无数据": Exit Function
    End If

    ' 步骤1：小样本 → 不操作
    If 小样本标记 <> "" Then
        日冲过滤 = "小样本，忽略": Exit Function
    End If

    ' 步骤2：战场过滤
    Select Case sDXEF
        Case "金", "银"
            ' 金银：主战场，继续
        Case "唏"
            ' 唏：过渡区，需额外条件
            If sDXCD <> "上" And sDXCD <> "忐" Then
                日冲过滤 = "唏区非上/忐，不操作": Exit Function
            End If
        Case Else
            ' 嘘/屎/尿：不操作
            日冲过滤 = "战场禁止": Exit Function
    End Select

    ' 步骤3：→ZE+ZC+ZA 过滤（核心安全指标）
    If pZA < 10 Then
        日冲过滤 = "ZA<10%，风险高": Exit Function
    End If

    ' 步骤4：管宽过滤（如有数据）
    If 管宽 >= 0 Then
        If 管宽 < 5 Then
            日冲过滤 = "管宽<5，波动不足": Exit Function
        End If
    End If

    ' 步骤5：柱排过滤（如有数据）
    If 柱排 <> "" Then
        If 柱排 = "跌" Then
            日冲过滤 = "柱排=跌，等待": Exit Function
        End If
    End If

    ' 通过所有过滤 → 可操作
    ' 根据DSHA>1判断力度
    If pDSHA1 >= 80 Then
        日冲过滤 = "✅ 可操作（强）"
    ElseIf pDSHA1 >= 50 Then
        日冲过滤 = "✅ 可操作（中）"
    Else
        日冲过滤 = "⚠️ 可操作（弱）"
    End If
End Function


' ===== 辅助函数：日冲建议速查（单行版） =====
' 在Excel中直接使用：=日冲建议(A1,B1,C1)
Public Function 日冲建议(ByVal sDXEF As String, ByVal sDXCD As String, ByVal sDXAB As String) As String
    Dim pZA As Double, pDSHA1 As Double, 小样本标记 As String
    If Not 日冲三指标(sDXEF, sDXCD, sDXAB, pZA, pDSHA1, 小样本标记) Then
        日冲建议 = "无数据": Exit Function
    End If
    If 小样本标记 <> "" Then
        日冲建议 = "小样本忽略": Exit Function
    End If

    ' 三军会审：三指标同时判断
    ' →ZE+ZC+ZA >= 30% 且 DSHA>1 >= 30% → 可操作
    ' →ZE+ZC+ZA >= 10% 且 DSHA>1 >= 10% → 谨慎
    ' 其他 → 禁止
    If pZA >= 30 And pDSHA1 >= 30 Then
        日冲建议 = "可操作"
    ElseIf pZA >= 10 And pDSHA1 >= 10 Then
        日冲建议 = "谨慎"
    Else
        日冲建议 = "禁止"
    End If
End Function


' ===== 测试函数：验证数据加载 =====
Public Sub ZPY_日冲评分_测试()
    ' 测试几个典型分支
    Dim tests As Variant
    tests = Array( _
        Array("金", "上", "上"), _
        Array("金", "上", "忑"), _
        Array("金", "忑", "忑"), _
        Array("银", "忠", "下"), _
        Array("唏", "上", "上"), _
        Array("屎", "上", "上"), _
        Array("尿", "忑", "忑"))

    Dim i As Long
    Dim pZA As Double, pDSHA1 As Double, 小样本标记 As String
    Dim score As Double, filter As String

    Debug.Print "DXEF", "DXCD", "DXAB", "→ZE+ZC+ZA", "DSHA>1", "小样本", "评分", "过滤结果"
    Debug.Print "----", "----", "----", "---------", "------", "------", "----", "--------"

    For i = 0 To UBound(tests)
        Call 日冲三指标(tests(i)(0), tests(i)(1), tests(i)(2), pZA, pDSHA1, 小样本标记)
        score = 日冲综合评分(tests(i)(0), tests(i)(1), tests(i)(2), 15)
        filter = 日冲过滤(tests(i)(0), tests(i)(1), tests(i)(2), 15, "升")
        Debug.Print tests(i)(0), tests(i)(1), tests(i)(2), pZA, pDSHA1, 小样本标记, score, filter
    Next i

    MsgBox "测试完成，查看即时窗口(Ctrl+G)查看结果"
End Sub