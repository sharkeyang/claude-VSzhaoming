{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(d:/@VSwork/**/*)",
      "Write(d:/@VSwork/**/*)",
      "Edit(d:/@VSwork/**/*)",
      "Glob(d:/@VSwork/**/*)",
      "Grep(d:/@VSwork/**/*)",
      "Bash(python -c ' *)",
      "Bash(timeout 30 python -c ' *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"d:/@VSwork/VS昭明计划VBA优化/.claude/fix_ps1_encoding.py\""
          }
        ]
      }
    ],
    "Stop": []
  },
  "skipDangerousModePermissionPrompt": true
}
