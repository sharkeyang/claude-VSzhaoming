            '注意20230202：WJD/WJC需要考察距离【现在价格】多远；回撤是已经走了多远到现在；两者公式不同。
            '醍醐灌顶20230629：删去所有周临价格，使用周今价格。保证与周局等匹配，如果需要看临时价格则使用sSSC结算模式。
            '醍醐灌顶20240206：为何以哼或哈为分母，是因为哼或哈是已经达到的价位，从这个价位回到JA会变动多少，或从这个价位到现价已经变动了多少。
            '醍醐灌顶20240209：公式的变化为原来【以哼或哈为分母】变为【以JA为分母】，这是是因为操盘思路的改变，在哼或哈只会平仓，只会在低位如WJA开仓。而回撤也是在JA开仓但在哼未卖出后损失的收益。
            '============================================================================
                If 周类BTZC > 0 Then
                        If 组结算(X, 基位周类 + 位os龟结哼) > 0 And 周类JA > 0 Then
                            '撤：从WJA到哼的最大涨幅，即从WJA开仓曾经达到的最大涨幅。代表喇叭的宽度。
                            谕组(X, 位谕of周管宽哼JA) = Int(((组结算(X, 基位周类 + 位os龟结哼) - 周类JA) / 周类JA) * 100)
                            '撤：从WJA开仓曾经达到的最大涨幅后会吐的收益。代表回撤。
                            谕组(X, 位谕of周管撤哼JA) = Int(((组结算(X, 基位周类 + 位os龟结哼) - 周类今收) / 周类JA) * 100)
                        End If
                '--------------------------------------------------------------------
                Else
                        If 组结算(X, 基位周类 + 位os龟结哈) > 0 And 周类JA > 0 Then
                            谕组(X, 位谕of周管宽哼JA) = Int(((周类JA - 组结算(X, 基位周类 + 位os龟结哈)) / 周类JA) * 100)
                            谕组(X, 位谕of周管撤哼JA) = Int(((周类今收 - 组结算(X, 基位周类 + 位os龟结哈)) / 周类JA) * 100)
                        End If
                End If
            '============================================================================
            '衍生：丘宽。树立最基本思想，抓住从WJC出发的丘宽。
            '============================================================================
                If 周类BTZC > 0 Then
                        If 组结算(X, 基位周类 + 位os龟结顶) > 0 And 周类JC > 0 Then
                            谕组(X, 位谕of周层盈丘幅) = Int(((组结算(X, 基位周类 + 位os龟结顶) - 周类JC) / 周类JC) * 100)
                        End If
                End If
            '============================================================================
'########################################################################################
            
            
            
            
            
            
            
'########################################################################################
'微观衍生：日类【工具箱】
'########################################################################################
            '============================================================================
            '【顶触】是否创新高。创新高应该卖。
            '【至理箴言】什么时候创新高都应该考虑【是否先卖出】。
            '注20240221：不受ZC>0限制，只要创新高就可以卖出。
            '============================================================================
            谕组(X, 位谕of日龟顶触) = 组结算(X, 基位日类 + 位os龟具顶触)  '用于设置【日叠】的底色，必须每个单元都有值。
            谕组(X, 位谕of日龟BT顶) = 组结算(X, 基位日类 + 位os龟BT顶)
            谕组(X, 位谕of日龟BT哼) = 组结算(X, 基位日类 + 位os龟BT哼)
            谕组(X, 位谕of日龟BT合顶哼) = 组结算(X, 基位日类 + 位os龟BT合顶)  '用于设置【日叠】的底色，必须每个单元都有值。
            '============================================================================
            '日层状态
            '============================================================================
            谕组(X, 位谕of日层类合) = 组结算(X, 基位日类 + 位os基层类)
            谕组(X, 位谕of日参横类) = 组结算(X, 基位日类 + 位os基横类)
            谕组(X, 位谕of日参竖态) = 组结算(X, 基位日类 + 位os基竖态)
            '============================================================================
            '中轴线DJB
            '============================================================================
            If 日类BTZE > 0 And 日类BTZC > 0 Then
                    谕组(X, 位谕of日层BTZA) = 日类BTZA
                    谕组(X, 位谕of日层BT连阳) = 组结算(X, 基位日类 + 位osBTPR1)
                    If 组结算(X, 基位日类 + 位os具BT鼎) > 0 Then
                        谕组(X, 位谕of日层BT鼎) = 组结算(X, 基位日类 + 位os具BT鼎)
                    End If
            End If
            '============================================================================
            '设置参数：偏
            '============================================================================
            If 日类JA <> 0 Then 谕组(X, 位谕of日层脸哼JA) = Round((组结算(X, 基位日类 + 位os龟结哼) / 日类JA - 1) * 100, 1)
            If 日类JA <> 0 Then 谕组(X, 位谕of日层BSHA) = Round((日类今高 / 日类JA - 1) * 100, 1)
            If 日类JA <> 0 Then 谕组(X, 位谕of日层BSLA) = Round((日类今低 / 日类JA - 1) * 100, 1)
            If 日类JC <> 0 Then 谕组(X, 位谕of日层BSAC) = Round((日类JA / 日类JC - 1) * 100, 1)
            '============================================================================
'########################################################################################
'微观衍生：日类【工具箱】日管
'########################################################################################
            '============================================================================
            '日管上符串：研究是否在管内运动【哼JA】
            '适用场景：进入管过程。
            '============================================================================
            谕组(X, 位谕of日管上符串) = 组结算(X, 基位日类 + 位os具上符串)
            谕组(X, 位谕of日管上符范) = 组结算(X, 基位日类 + 位os具上符范)
            '============================================================================
            '日管并符
            '============================================================================
            谕组(X, 位谕of日管并符串) = 组结算(X, 基位日类 + 位os具并符串)
            '============================================================================
            '日管中符串：研究是否柱频繁贯穿WJA
            '适用场景：（千万注意）只适用于在管尾部侦测即将脱轨。
            '============================================================================
            谕组(X, 位谕of日管中符串) = 组结算(X, 基位日类 + 位os具中符串)
            谕组(X, 位谕of日管中符范) = 组结算(X, 基位日类 + 位os具中符范)
            '============================================================================
            '日管宽符
            '醍醐灌顶20240212：将周类【哼JA管】映射为日类【顶JC管】。利用DJB作为持仓成本线，在其上有缓冲垫，在其下捡漏。
            '醍醐灌顶20240221：主要用于逃顶，所以将条件设为（ZE>0且ZC>0），而非（ZC>0）看（哼JC），（ZC<0）看（哈JC）
            '============================================================================
            谕组(X, 位谕of日管宽符串) = 组结算(X, 基位日类 + 位os具宽符串)
            '--------------------------------------------------------------------
            谕组(X, 位谕of日层偏顶JC) = ""
            谕组(X, 位谕of日层宽哼JC) = ""
            谕组(X, 位谕of日层撤哼JC) = ""
            If 日类BTZC > 0 Then
                If 日类JC <> 0 Then
                    谕组(X, 位谕of日层偏顶JC) = Int(((组结算(X, 基位日类 + 位os龟结顶) - 日类JC) / 日类JC) * 100)
                    谕组(X, 位谕of日层宽哼JC) = Int(((组结算(X, 基位日类 + 位os龟结哼) - 日类JC) / 日类JC) * 100)
                    谕组(X, 位谕of日层撤哼JC) = Int(((组结算(X, 基位日类 + 位os龟结哼) - 日类今收) / 日类JC) * 100)
                End If
            End If
            谕组(X, 位谕of日层宽哈JC) = ""
            If 日类BTZC < 0 Then
                If 日类JC <> 0 Then
                    谕组(X, 位谕of日层宽哈JC) = Int(((组结算(X, 基位日类 + 位os龟结哈) - 日类JC) / 日类JC) * 100)
                End If
            End If
            '============================================================================
'########################################################################################
'########################################################################################
            
            
            
'########################################################################################
'盈提示：周级别
'########################################################################################
            '============================================================================
            '层止盈：原【IS暴】
            '设置暴模式警告，属于左侧指标，对周局以及周横没有要求，只要在大通道且指标符合就给与提示。
            '使用条件：处于大通道，且t哼>=-2。代表刚创过新高不久，如果时间上没有继续创新高，且空间上回撤较大，就给与提示。
            '醍醐灌顶20240210：暴要放入【周龟系】中，因为不是在【周管系】才会暴。包含【宽龙/层龙/久龙】
            '醍醐灌顶20240427：【左侧止盈】包含/管宽/偏/久
            '============================================================================
                谕组(X, 位谕of周层盈提示) = ""
                If 周类BTZC > 0 Then
                    '--------------------------------------------------------------------
                    '判断是否止盈：【宽】根据CIDL类别不同设定不同阈值
                    If UBCID是中股票(CIDL) = True Then
                        If 谕组(X, 位谕of周管宽哼JA) > 20 Then 谕组(X, 位谕of周层盈提示) = 谕组(X, 位谕of周层盈提示) & "宽"
                    ElseIf UBCID是中股指(CIDL) Or UBCID是中股基(CIDL) Then
                        If 谕组(X, 位谕of周管宽哼JA) > 15 Then 谕组(X, 位谕of周层盈提示) = 谕组(X, 位谕of周层盈提示) & "宽"
                    End If
                    '--------------------------------------------------------------------
                    '判断是否止盈：【高】【低】根据线上线下设定不同阈值
                    If UBCID是中股票(CIDL) = True Then
                        If 周类BTZC > 0 Then
                            If 组结算(X, 基位周类 + 位os结幅HR0) > 15 Then 谕组(X, 位谕of周层盈提示) = 谕组(X, 位谕of周层盈提示) & "高"
                        'Else
                        '    If 组结算(X, 基位周类 + 位os结幅LR0) < -15 Then 谕组(X, 位谕of周层盈提示) = 谕组(X, 位谕of周层盈提示) & "低"
                        End If
                    ElseIf UBCID是中股指(CIDL) Or UBCID是中股基(CIDL) Then
                        If 周类BTZC > 0 Then
                            If 组结算(X, 基位周类 + 位os结幅HR0) > 10 Then 谕组(X, 位谕of周层盈提示) = 谕组(X, 位谕of周层盈提示) & "高"
                        'Else
                        '    If 组结算(X, 基位周类 + 位os结幅LR0) < -10 Then 谕组(X, 位谕of周层盈提示) = 谕组(X, 位谕of周层盈提示) & "低"
                        End If
                    End If
                    '--------------------------------------------------------------------
                    '判断是否止盈：【连阳】【BTZA久】
                    If 谕组(X, 位谕of周波龄BTPR0) >= 3 Then
                        谕组(X, 位谕of周层盈提示) = 谕组(X, 位谕of周层盈提示) & "连" & 谕组(X, 位谕of周波龄BTPR0)
                    'ElseIf 谕组(X, 位谕of周类BTZA) >= 9 Then
                    '    谕组(X, 位谕of周层盈提示) = 谕组(X, 位谕of周层盈提示) & "久ZA9"
                    End If
                    '====================================================================
                    '【废弃风控指标】20241221
                    '====================================================================
                    '--------------------------------------------------------------------
                    '注20241221：巨幅主升时，丘宽可以非常大，不再作为风险指标。
                    ''判断是否止盈：【丘】不是强制指标，但算法核心是偏离WJC，所以可以参考。
                    'If UBCID是中股票(CIDL) = True Then
                    '    If 谕组(X, 位谕of周层盈丘幅) >= 40 Then 谕组(X, 位谕of周层盈提示) = 谕组(X, 位谕of周层盈提示) & "丘"
                    'ElseIf UBCID是中股指(CIDL) Or UBCID是中股基(CIDL) Then
                    '    If 谕组(X, 位谕of周层盈丘幅) >= 30 Then 谕组(X, 位谕of周层盈提示) = 谕组(X, 位谕of周层盈提示) & "丘"
                    'End If
                    '--------------------------------------------------------------------
                    ''判断是否止盈：【叠】根据CIDL类别不同设定不同阈值
                    'If UBCID是中股票(CIDL) = True Then
                    '    If 谕组(X, 位谕of周波今叠幅) >= 50 Then 谕组(X, 位谕of周层盈提示) = 谕组(X, 位谕of周层盈提示) & ".叠"
                    'ElseIf UBCID是中股指(CIDL) Or UBCID是中股基(CIDL) Then
                    '    If 谕组(X, 位谕of周波今叠幅) >= 30 Then 谕组(X, 位谕of周层盈提示) = 谕组(X, 位谕of周层盈提示) & ".叠"
                    'End If
                    '====================================================================
                End If
            '============================================================================
'########################################################################################
'盈提示：日级别
'########################################################################################
            '============================================================================
            '【卖提示】提供更苛刻条件用于【左侧止盈】
            '（0）【卖顶】是否创新高：/触顶否
            '（1）【卖高】是否单柱涨幅大：/高幅
            '（2）【卖宽】是否（哼JC管）过宽过陡：/管宽（哼JC）/陡（均线拉开距离）
            '（3）【卖叠】是否连续涨幅过大/是否连续阳柱：/叠（连续波幅）/连阳数
            '============================================================================
            谕组(X, 位谕of日层盈提示) = ""
            If 日类BTZC > 0 Then
                    '====================================================================
                    '是否触顶：是否创新高
                    '====================================================================
                    If Right(谕组(X, 位谕of日龟顶触), 1) = "高" Then
                        If 组结算(X, 基位日类 + 位os龟BT顶) >= 0 Then
                                '注20240714：在触哼时提示卖出。
                                谕组(X, 位谕of日层盈提示) = 谕组(X, 位谕of日层盈提示) & "a"
                        Else
                                谕组(X, 位谕of日层盈提示) = 谕组(X, 位谕of日层盈提示) & "雀"
                        End If
                    End If
                    '====================================================================
                    '【卖宽】是否（哼JC管）过宽过陡
                    '====================================================================
                    '注：当【管宽】较大，且回撤未过半的时候进行提示。回撤过多就不要提示了
                    If VBA.IsNumeric(谕组(X, 位谕of日层撤哼JC)) = True Then
                    If 谕组(X, 位谕of日层撤哼JC) <= 谕组(X, 位谕of日层宽哼JC) * 0.5 Then
                        If 谕组(X, 位谕of日层宽哼JC) > 20 Then
                            谕组(X, 位谕of日层盈提示) = 谕组(X, 位谕of日层盈提示) & "宽"
                        End If
                    End If
                    End If
                    '------------------------------------------------------------
                    '待解决【陡】如何建模
                    '【陡】偏BSBC过大代表之前有过一大波涨幅。不要参与顶部或尾部。等待均线距离拉近再次蓄势。
                    '待完成：改为利用BSAC来描述【陡】
                    'If 谕组(X, 位谕of日层BSAC) >= 7 Then
                    '        谕组(X, 位谕of日层盈提示) = 谕组(X, 位谕of日层盈提示) & "陡"
                    'End If
                    '====================================================================
                    '【卖连】是否连续涨幅过大/是否连续阳柱
                    '注202409015：【叠】不需要过度考虑，暂时隐藏该列。
                    '====================================================================
                    If 谕组(X, 位谕of日波龄BTPR0) >= 3 Then
                        谕组(X, 位谕of日层盈提示) = 谕组(X, 位谕of日层盈提示) & "连" & 谕组(X, 位谕of日波龄BTPR0)
                    End If
                    '====================================================================
                    '【卖偏】是否单柱涨幅大。抓住单柱冲高进行卖出。
                    '====================================================================
                    If 谕组(X, 位谕of日波BSHR) >= 5 Then
                            谕组(X, 位谕of日层盈提示) = 谕组(X, 位谕of日层盈提示) & "高"    '高幅3就应止盈
                    ElseIf 谕组(X, 位谕of日层BSHA) >= 6 Then
                            谕组(X, 位谕of日层盈提示) = 谕组(X, 位谕of日层盈提示) & "偏"
                    End If
                    '====================================================================
            End If
            '============================================================================
'########################################################################################
            
            
            
            
            
            
            
