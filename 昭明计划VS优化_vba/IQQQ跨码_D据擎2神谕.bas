            If InStr(谕组(X, 位谕of周层三鳄), "屎") > 0 _
            Or InStr(谕组(X, 位谕of周层三鳄), "尿") > 0 _
            Or InStr(谕组(X, 位谕of周层三鳄), "唏") > 0 _
            Or InStr(谕组(X, 位谕of周层三鳄), "嘘") > 0 Then
                    '只针对（金）：WXCD＞0且WXZC＞0
            '----------------------------------------------------------------------------
            ElseIf InStr(谕组(X, 位谕of周层三鳄), "银") > 0 Then
                    '因为下破WJB，仍属于周级别持有条件，但不要放入日级别捡漏机会。
            ElseIf InStr(谕组(X, 位谕of周层护型), "己") > 0 Then
                    '因WXAB＜0，属于周级别介入机会，但不要放入日漏机会。
            '----------------------------------------------------------------------------
            '主战场：①金②层段=甲乙（对于日级别，只针对WXAB＞0）
            '是否要求WXAB＞0：要求，只要"甲乙"就可以；"已"存续时间太短，且存在不确定性；"丙"属于已下破WJB，可能有机会，但更多机会存在于"甲乙"。
            '----------------------------------------------------------------------------
            ElseIf InStr(谕组(X, 位谕of周层护型), "甲") > 0 _
                Or InStr(谕组(X, 位谕of周层护型), "乙") > 0 Then
                    '====================================================================
                    '限制WXCD
                    '====================================================================
                    '值日层漏提示 = 值日层漏提示 &  "金"
                    '====================================================================
                    '注20251220：新逻辑不再按照【周中符】进行分类，而要按照【周√口】进一步区分潜在的【主升/震荡】进行筛选。
                    '====================================================================
                    If InStr(谕组(X, 位谕of周层大局), "龙猪") Then
                        值日层漏提示 = 值日层漏提示 & "猪"
                    ElseIf InStr(谕组(X, 位谕of周层大局), "龙管") Then
                        值日层漏提示 = 值日层漏提示 & "管"
                    ElseIf InStr(谕组(X, 位谕of周层大局), "震正〇") Then
                        值日层漏提示 = 值日层漏提示 & "〇"    '震正〇
                    ElseIf InStr(谕组(X, 位谕of周层大局), "头") Then
                        值日层漏提示 = 值日层漏提示 & "头"
                    Else
                        值日层漏提示 = 值日层漏提示 & "震"
                    End If
                    '====================================================================
                    '按WTZA分类：按WXZA分类：WTZA≥2（甲）WTZA=1（丙）WTZA=-1（乙）。要求前柱在WJA之上，若前柱在WJA之下，不认为存在日类机会。所有这些是基于理念，在JA之上就会有下注冲高。
                    '====================================================================
                    值日层漏提示 = 值日层漏提示 & Mid$(谕组(X, 位谕of周层护型), 2, 1)
                    If 周类BTZA >= 2 Then
                        值日层漏提示 = 值日层漏提示 & "②"
                        是否提供日漏信息 = True
                    ElseIf 周类BTZA = 1 Then
                        值日层漏提示 = 值日层漏提示 & "①"
                        是否提供日漏信息 = True
                    Else
                        是否提供日漏信息 = False
                    End If
                    '====================================================================
            End If
            '----------------------------------------------------------------------------
            '漏斗：过滤特定周柱排。
            '----------------------------------------------------------------------------
            If 是否提供日漏信息 = True Then
                    '====================================================================
                    '特殊周柱型1：连阳
                    '====================================================================
                    If Right(组结算(X, 基位周类 + 位os具并符串), 1) = 常枚并符升连 Then
                        值日层漏提示 = 值日层漏提示 & "升连"
                    '====================================================================
                    '特殊柱型2：继鼎
                    '====================================================================
                    ElseIf InStr(组结算(X, 基位周类 + 位os基竖态), "鼎继") > 0 Then
                        值日层漏提示 = 值日层漏提示 & "鼎继"
                    '====================================================================
                    '特殊柱型2：首鼎
                    '====================================================================
                    ElseIf InStr(组结算(X, 基位周类 + 位os基竖态), "鼎首") > 0 Then
                        值日层漏提示 = 值日层漏提示 & "鼎首"
                    '====================================================================
                    Else
                        是否提供日漏信息 = False
                    End If
                    '====================================================================
            End If
            '----------------------------------------------------------------------------
            '漏斗：过滤日类信息。
            '----------------------------------------------------------------------------
            If 是否提供日漏信息 = True Then
                    谕组(X, 位谕of日层漏提示) = 值日层漏提示
                    谕组(X, 位谕of日层漏提示) = 谕组(X, 位谕of日层漏提示) & "."
                    '====================================================================
                    '按日层类分类：（甲乙己）存在机会；（丙）被动持有；（丁戊）警告且被动持有，不算做捡漏。
                    '然后再根据日类柱型进行分类。
            '针对"甲乙己"，若为阴柱后阳柱，则为机。增加"鼎"参考价值。
                    '====================================================================
                    '--------------------------------------------------------------------
                    '理论上当前周WTZA≥1，本周只要DTZA＜0就应考虑是否属于漏。
                    '情况1：但是，若日为"丁戊"，则不要认为是日漏，需要报警。
                    '--------------------------------------------------------------------
                    If InStr(谕组(X, 位谕of日层护型), "丁") > 0 _
                    Or InStr(谕组(X, 位谕of日层护型), "戊") > 0 Then
                        谕组(X, 位谕of日层漏提示) = 谕组(X, 位谕of日层漏提示) & Mid$(谕组(X, 位谕of日层护型), 2, 1) & "被"
                        '当满足（DXZC＞0且DXAB＞0）但（护型为丁戊）：只被动持有，勿主动介入。未下破WJC或DJD，不要止损。
                    '--------------------------------------------------------------------
                    '情况2：丙。
                    '--------------------------------------------------------------------
                    ElseIf InStr(谕组(X, 位谕of日层护型), "丙") > 0 Then
                        谕组(X, 位谕of日层漏提示) = 谕组(X, 位谕of日层漏提示) & "丙漏"
                    '--------------------------------------------------------------------
                    '情况3：针对日层段（甲乙己）
                    '--------------------------------------------------------------------
                    Else
                        If 日类BTZA < 0 Then
                                '针对DJA之下：应出现a-b-c反弹，才认为是日漏
                                谕组(X, 位谕of日层漏提示) = 谕组(X, 位谕of日层漏提示) & "乙e漏"
                                '如果在DJA之下出现阳柱，要提示
                        ElseIf 日类BTZA <= 1 Then
                                '当DTZA=1，要看是否为诱多
                                谕组(X, 位谕of日层漏提示) = 谕组(X, 位谕of日层漏提示) & Mid$(谕组(X, 位谕of日层护型), 2, 1) & "首防诱"
                        Else
                            If 日类今涨 <= 0 Then
                                谕组(X, 位谕of日层漏提示) = 谕组(X, 位谕of日层漏提示) & Mid$(谕组(X, 位谕of日层护型), 2, 1) & "上漏" & Right(组结算(X, 基位日类 + 位os具并符串), 1)
                                '典型漏：当属于龙b，且本阴柱为跌孕时，可以捡漏。
                                '当在DJA之上，出现回调，且出现阳柱时，才是进入之时。
                                '对于阴柱后阳柱，也提示为漏
                                '对与鼎（特别是继鼎），也提示为漏。
                            Else
                                谕组(X, 位谕of日层漏提示) = 谕组(X, 位谕of日层漏提示) & Mid$(谕组(X, 位谕of日层护型), 2, 1) & "上持"
                                
                            End If
                        End If
                        '================================================================
                        '添加鼎
                        '================================================================
                        If 谕组(X, 位谕of日层BT鼎) = 1 Then
                            谕组(X, 位谕of日层漏提示) = 谕组(X, 位谕of日层漏提示) & "鼎"
                        End If
                        '================================================================
                        '添加柱型
                        '================================================================
                        If InStr(谕组(X, 位谕of日层柱型), "梯") > 0 _
                        Or InStr(谕组(X, 位谕of日层柱型), "栏") > 0 _
                        Or InStr(谕组(X, 位谕of日层柱型), "栅") > 0 _
                        Or InStr(谕组(X, 位谕of日层柱型), "枝") > 0 Then
                            谕组(X, 位谕of日层漏提示) = 谕组(X, 位谕of日层漏提示) & Left$(谕组(X, 位谕of日层柱型), 4)
                        End If
                        '================================================================
                    End If
                    '====================================================================
            End If
            '============================================================================
'########################################################################################
            
            
            
            
            
            
'@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
'@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
'@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
            '============================================================================
            '策分: 周浮仓评分 (0~100), 基于真高幅回测数据
            '注2026-07-18 全量7463只验证：WXAB等级质量排名
            '   乙(89.0%) > 甲(76.3%) > 丙(56.6%) > 己(28.1%) > 戊(2.9%)
            '   双向带动：正向(丙丁戊→甲乙己)=61.1%  反向(甲乙己→丙丁戊)=81.6%
            '策分: 概率即分数 — 匹配策略 + 查概率表
            '============================================================================
            周局 = 谕组(X, 位谕of周层大局)
            周护 = 谕组(X, 位谕of周层护型)
            Dim 周ZA As Double: 周ZA = 谕组(X, 位谕of周类BTZA)
            Dim 周柱排 As String: 周柱排 = 谕组(X, 位谕of周层柱排)
            Dim 周盈提 As String: 周盈提 = 谕组(X, 位谕of周层盈提示)
            Dim 周波型 As String: 周波型 = 谕组(X, 位谕of周层波型)
            Dim 周策略 As String: 周策略 = ""
            Dim 周市板 As String: 周市板 = 谕组(X, 位qt市板)
            ' 市板为空时，从花册单行查询
            If 周市板 = "" Then 周市板 = IQQQ跨码工具_获取单码市板(CIDL)
        
            '按条件严格度降序匹配（最严格优先）
            If InStr(周局, "金") > 0 And InStr(周护, "甲") + InStr(周护, "乙") + InStr(周护, "己") > 0 Then
                If Left$(周柱排, 1) = "升" And InStr(周柱排, "尾反孕") = 0 Then
                    If InStr(周盈提, "高") > 0 Then
                        If InStr(周波型, "龙猪") > 0 Or InStr(周波型, "龙管") > 0 Then
                            周策略 = "金升非盈龙"
                        Else
                            周策略 = "金升非盈"
                        End If
                    Else
                        周策略 = "金升非"
                    End If
                ElseIf Left$(周柱排, 1) = "升" Then
                    周策略 = "金升"
                Else
                    周策略 = "金长"
                End If
            ElseIf InStr(周局, "银") > 0 Then
                If InStr(周盈提, "高") > 0 Or InStr(周盈提, "宽") > 0 Then
                    周策略 = "银盈"
                ElseIf InStr(周护, "己") > 0 Then
                    周策略 = "银己"
                ElseIf Left$(周柱排, 1) = "升" Then
                    周策略 = "银升"
                ElseIf InStr(周波型, "龙猪") > 0 Then
                    周策略 = "银猪"
                ElseIf 周ZA > 5 And 周ZA <= 10 Then
                    周策略 = "银ZA"
                End If
            End If
        
            '查概率表并写入
            If 周策略 <> "" Then
                Dim 周策分P3编码 As String: 周策分P3编码 = IQQQ跨码工具_查周策分P3(周策略)
                谕组(X, 位谕of周策略P3) = 周策略
                If 周策分P3编码 = "" Then
                    谕组(X, 位谕of周策分P3) = "_"
                Else
                    '20260816：策分表已是G/_格式，直接存储
                    谕组(X, 位谕of周策分P3) = 周策分P3编码
                End If
            Else
                '20260815：策略名为空时，策分也设为_（统一）
                谕组(X, 位谕of周策分P3) = "_"
            End If
            '============================================================================
            'P1概率表（基于完整梯度框架：ZA分段+等类+地型+柱排+WXCD+WXAB）
            '============================================================================
            Dim 周策略P1 As String
            Dim 周等类 As String: 周等类 = ""
            Dim 周末符 As String: 周末符 = Right$(谕组(X, 位谕of周管中符串), 1)
            If 周ZA = 1 Then
                周等类 = "等1"
            ElseIf 周ZA > 0 Then
                If 周ZA >= 2 And InStr("AB", 周末符) > 0 Then
                    周等类 = "等3"
                ElseIf 周ZA >= 2 And InStr("CDEF", 周末符) > 0 Then
                    周等类 = "等2"
                End If
            ElseIf 周ZA = -1 Then
                周等类 = "等5"
            ElseIf 周ZA < 0 Then
                If 周ZA <= -2 And InStr("EF", 周末符) > 0 Then
                    周等类 = "等7"
                ElseIf 周ZA <= -2 And InStr("ABCD", 周末符) > 0 Then
                    周等类 = "等6"
                End If
            End If
            '============================================================================
            'P1策略名生成与查表
            '============================================================================
            周策略P1 = IQQQ跨码工具_生成P1编码(周ZA, 周等类, 组结算(X, 基位周类 + 位os层地型), 周柱排, 周局, 周护)
            If 周策略P1 <> "" Then
                Dim 周策分P1 As String: 周策分P1 = IQQQ跨码工具_查周策分P1(周策略P1)
                If 周策分P1 = "" Then
                    谕组(X, 位谕of周策分P1) = "_"
                Else
                    '20260816：策分表已是G/_格式，直接存储
                    谕组(X, 位谕of周策分P1) = 周策分P1
                    谕组(X, 位谕of周策略P1) = 周策略P1
                End If
            Else
                '20260815：策略名为空时，策分也设为_（统一）
                谕组(X, 位谕of周策分P1) = "_"
            End If
            '============================================================================
            'ZA策略（基于柱排+顶触+盈提示三维分类，维持WXZA>0概率）
            '============================================================================
            If 周ZA > 0 Then
                '生成ZA策略名：柱排|顶触|盈提示
                Dim 周ZA柱排 As String: 周ZA柱排 = 谕组(X, 位谕of周层柱排)
                Dim 周ZA顶触 As String: 周ZA顶触 = 谕组(X, 位谕of周龟顶触)  '使用位os龟具顶触（如G0一高、G1逐高），非位os基顶型（a龙/b龙）
                Dim 周ZA盈提 As String: 周ZA盈提 = 谕组(X, 位谕of周层盈提示)
                Dim 周ZA策略 As String: 周ZA策略 = ""

                '柱排形态
                If Left$(周ZA柱排, 1) = "升" Then
                    If InStr(周ZA柱排, "尾连") > 0 Then
                        周ZA策略 = "连阳"
                    ElseIf InStr(周ZA柱排, "尾吞") > 0 Then
                        周ZA策略 = "升吞"
                    ElseIf InStr(周ZA柱排, "尾反孕") > 0 Then
                        周ZA策略 = "升反孕"
                    Else
                        周ZA策略 = "其他"
                    End If
                ElseIf Left$(周ZA柱排, 1) = "跌" Then
                    If InStr(周ZA柱排, "尾连") > 0 Then
                        周ZA策略 = "连跌"
                    ElseIf InStr(周ZA柱排, "尾吞") > 0 Then
                        周ZA策略 = "跌吞"
                    ElseIf InStr(周ZA柱排, "尾反孕") > 0 Then
                        周ZA策略 = "跌反孕"
                    Else
                        周ZA策略 = "其他"
                    End If
                ElseIf InStr(周ZA柱排, "吞吞") > 0 Then
                    周ZA策略 = "阴阳阴"
                ElseIf InStr(周ZA柱排, "孕孕") > 0 Then
                    周ZA策略 = "孕孕"
                Else
                    周ZA策略 = "其他"
                End If

                '顶触状态：使用位os龟具顶触的标准值（前2位，如G0/G1/G5/K5/L5）
                '顶触格式：{顶态}{恢复速度}{极五}，如G0一高、G1逐高、G5离撤、K5离撤
                If Len(周ZA顶触) >= 2 Then
                    周ZA策略 = 周ZA策略 & "|" & Left$(周ZA顶触, 2)
                Else
                    周ZA策略 = 周ZA策略 & "|无"
                End If

                '盈提示
                If InStr(周ZA盈提, "宽高连3") > 0 Then
                    周ZA策略 = 周ZA策略 & "|宽高连3"
                ElseIf InStr(周ZA盈提, "连3") > 0 Then
                    周ZA策略 = 周ZA策略 & "|连3"
                ElseIf InStr(周ZA盈提, "宽高") > 0 Then
                    周ZA策略 = 周ZA策略 & "|宽高"
                ElseIf InStr(周ZA盈提, "高") > 0 Then
                    周ZA策略 = 周ZA策略 & "|高"
                ElseIf InStr(周ZA盈提, "宽") > 0 Then
                    周ZA策略 = 周ZA策略 & "|宽"
                Else
                    周ZA策略 = 周ZA策略 & "|无"
                End If

                '查表
                Dim 周策分ZA As String: 周策分ZA = IQQQ跨码工具_查周策分ZA(周ZA策略)
                If 周策分ZA <> "" Then
                    谕组(X, 位谕of周策略ZA) = 周ZA策略
                    '20260816：ZA策分表已是G/_格式（无期望HR位），直接存储
                    谕组(X, 位谕of周策分ZA) = 周策分ZA
                Else
                    谕组(X, 位谕of周策略ZA) = ""
                    谕组(X, 位谕of周策分ZA) = "_"
                End If
            Else
                谕组(X, 位谕of周策略ZA) = ""
                谕组(X, 位谕of周策分ZA) = "_"
            End If
            '============================================================================
'@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
'月策略周
'@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
            '============================================================================
            '月基三变量：策略分类 + 命分(V1) + 策分(V2) + 带向(V3)
            '============================================================================
            '【设计思路】
            ' 月策略周的核心问题：一只股票，是否值得长期持有（月基）？
            ' 三个变量从不同维度回答这个问题：
            '
            ' V1 月策分命（股性分）——历史基因
            '   └─ 衡量该股历史上沿长期均线操作是否容易赚钱
            '   └─ 好股票：突破有效、上升稳定、回踩不破线 → 高分
            '   └─ 恶庄：突破反复贯穿、暴力回踩破线、长阴破多线 → 低分
            '   └─ 自然过滤恶庄，避免在"好股率低"的股票上浪费仓位
            '   └─ 数据来源：离线全量历史回测，CSV查表赋值
            '
            ' V2 月策分周（存续分）——走势维持（仅对多长三分类评分）
            '   └─ 当前走势预示后续1~5周是否继续维持月基状态
            '   └─ 与"周冲策略"的区别：
            '        周冲策略 = 子集，只关心下周是否冲高（P≥3%）
            '        月策分周 = 是否维持整体月基仓位（更宽，含横盘/缓涨等）
            '   └─ 高分信号：龙猪延续、升柱排延续、ZA稳定上升
            '   └─ 低分信号：触顶、跌吞、ZA下降、HR<0、ZC≤0、震正
            '
            '   └─ 核心：WXAB→WXCD双向带动
            '        11双好 = WXAB正+WXCD好  安全持有
            '        10反险 = WXAB负+WXCD好  反向风险81.6%
            '        01正潜 = WXAB正+WXCD差  正向潜力61.1%
            '        00双差 = WXAB负+WXCD差  观望不参与
            '   └─ 待扩展：WJB下破对WXCDXCD的带动、柱排启示
            '
            ' 三变量联合决策：
            '   命分高 + 策分高 + 带向双好 → 坚定持有（长多基仓）
            '   命分高 + 策分低 + 带向正潜 → 关注但准备减仓
            '   命分低 + 任何情况 → 天然不参与（恶庄过滤）
            '============================================================================
            '四域体系（月策略周分类的底层框架）：
            '  多长 = ZC>0+CD>0+ZB>0  → 内部三分类：积极/消极/不定
            '  多被 = ZC>0但CD≤0或ZB≤0 → 子分类：多被(金)=WXCD含金, 多被(银)=WXCD含银, 多被(唏)=WXCD不含金银
            '  NA(空看) = ZC≤0但CD/ZB有正
            '  NA(空长) = 三空全
            '============================================================================
            Dim 月基分类 As String: 月基分类 = ""
            Dim 月策分命 As Double: 月策分命 = 0
            Dim 月策分周 As Double: 月策分周 = 0
        
            '取四域值
            Dim 四域 As String: 四域 = 谕组(X, 位谕of周层四域)
        
            Select Case 四域
            Case "多长"
                '多长内部三分类：积极/消极/不定
                '  积极条件：龙猪（无需"+升排"，"+升排"增量仅1pp，MC3.11 2026-08-12）
                If InStr(周波型, "龙猪") > 0 Then
                    月基分类 = "多长(积极)"
                Else
                    '检查消极信号（从强到弱）
                    Dim 消极标志 As Boolean: 消极标志 = False
                    '① 跌吞：本周阴且幅度大于前周阳
                    Dim 本周涨 As Double: 本周涨 = 组结算(X, 基位周类 + 位os结幅PR0)
                    If 本周涨 < 0 And X > LBound(组结算, 1) Then
                        Dim 前周涨 As Double: 前周涨 = 组结算(X - 1, 基位周类 + 位os结幅PR0)
                        If 前周涨 > 0 And Abs(本周涨) > 前周涨 Then
                            消极标志 = True
                        End If
                    End If
                    '② ZA下降：本周ZA<前周ZA
                    If Not 消极标志 And X > LBound(组结算, 1) Then
                        Dim 前周ZA As Double: 前周ZA = 组结算(X - 1, 基位周类 + 位osBTZA)
                        If 周类BTZA < 前周ZA Then
                            消极标志 = True
                        End If
                    End If
                    '③ 本周HR<0（周线下跌）
                    If Not 消极标志 And 本周涨 < 0 Then
                        消极标志 = True
                    End If
                    '④ ZC≤0（C线失守）
                    If Not 消极标志 And 周类BTZC <= 0 Then
                        消极标志 = True
                    End If
                    '⑤ 震正波型
                    If Not 消极标志 And InStr(周波型, "震正") > 0 Then
                        消极标志 = True
                    End If
        
                    If 消极标志 Then
                        月基分类 = "多长(消极)"
                    Else
                        月基分类 = "多长(不定)"
                    End If
                End If
        
            Case "多被"
                '多被子分类：金系ZB≤0 vs 银系/其他CD≤0
                If InStr(周局, "金") > 0 Then
                    月基分类 = "多被(金)"
                ElseIf InStr(周局, "银") > 0 Then
                    月基分类 = "多被(银)"
                Else
                    月基分类 = "多被(唏)"
                End If
        
            Case "空看"
                月基分类 = "NA(空看)"
        
            Case "空长"
                月基分类 = "NA(空长)"
        
            Case Else
                月基分类 = "NA(空看)"  '兜底
            End Select
        
            'V1 月策分命（几何均值）— 从CSV查表
            'CSV路径：_产出物\_工具\vba表月策分命.txt，按代码(CIDL)匹配
            '评分公式：几何均值 = (∏(1+每次收益))^(1/交易次数) - 1
            '评级：仁慈>=20分 / 正常10~20分 / 震荡0~10分
            '逻辑：命分低=恶庄→天然不参与，命分高=好股→优先考虑月基持有
            IQQQ跨码工具_加载月策分命表
            If 月策分命表.Exists(CIDL) Then
                月策分命 = 月策分命表(CIDL)
            Else
                月策分命 = 0
            End If
            '============================================================================
            'V2 月策分周（存续分）— 仅对多长评分，查表赋值
            '设计原理：基于波型×柱排二维表，查续持率作为基础分
            '  50分为敏感阈值：≥50倾向于持有，<50倾向于退出
            '查表数据来源：全量4130只周线验证（MC3.10, 2026-08-12）
            '============================================================================
            If 四域 = "多长" Then
                '解析波型
                Dim V2波型 As String: V2波型 = "其他"
                If InStr(周波型, "龙猪") > 0 Then
                    V2波型 = "龙猪"
                ElseIf InStr(周波型, "龙管") > 0 Then
                    V2波型 = "龙管"
                ElseIf InStr(周波型, "头正") > 0 Then
                    V2波型 = "头正"
                ElseIf InStr(周波型, "震正") > 0 Then
                    V2波型 = "震正"
                ElseIf InStr(周波型, "震负") > 0 Then
                    V2波型 = "震负"
                End If
        
                '解析柱排
                Dim V2柱排 As String: V2柱排 = "其他"
                Dim 柱排首字 As String: 柱排首字 = Left$(周柱排, 1)
                If 柱排首字 = "升" Then
                    V2柱排 = "升排"
                ElseIf 柱排首字 = "人" Then
                    V2柱排 = "人排"
                ElseIf 柱排首字 = "跌" Then
                    V2柱排 = "跌排"
                End If
        
                '查基础分表：波型×柱排 → 续持率（取整，基于MC3.10全量4130只周线验证修正）
                '  原分虚高10~20分，修正为实际P3值（2026-08-12）
                Select Case V2波型
                Case "龙猪"
                    Select Case V2柱排
                    Case "升排": 月策分周 = 59
                    Case "人排": 月策分周 = 61
                    Case "跌排": 月策分周 = 47
                    Case Else:   月策分周 = 51
                    End Select
                Case "龙管"
                    Select Case V2柱排
                    Case "升排": 月策分周 = 51
                    Case "人排": 月策分周 = 58
                    Case "跌排": 月策分周 = 51
                    Case Else:   月策分周 = 51
                    End Select
                Case "头正"
                    Select Case V2柱排
                    Case "升排": 月策分周 = 52
                    Case "人排": 月策分周 = 58
                    Case "跌排": 月策分周 = 49
                    Case Else:   月策分周 = 51
                    End Select
                Case "震正"
                    Select Case V2柱排
                    Case "升排": 月策分周 = 52
                    Case "人排": 月策分周 = 56
                    Case "跌排": 月策分周 = 46
                    Case Else:   月策分周 = 48
                    End Select
                Case "震负"
                    Select Case V2柱排
                    Case "升排": 月策分周 = 50
                    Case "人排": 月策分周 = 58
                    Case "跌排": 月策分周 = 47
                    Case Else:   月策分周 = 49
                    End Select
                Case Else
                    Select Case V2柱排
                    Case "升排": 月策分周 = 54
                    Case "人排": 月策分周 = 57
                    Case "跌排": 月策分周 = 45
                    Case Else:   月策分周 = 48
                    End Select
                End Select
        
                'WXAB调节（基于MC3.10全量4130周线数据，真实P3差取值，2026-08-12）
                '  甲+5（P3=55.3%, vs基线+4.7pp），乙+3（P3=53.2%, +3.6pp）
                '  己+0（P3=51.4%, +1.8pp，边际效应≈0），丙-5（P3=45.2%, -4.5pp）
                '  丁-4（P3=46.1%, -3.6pp），戊-4（P3=45.5%, -4.1pp）
                If InStr(周护, "甲") > 0 Then
                    月策分周 = 月策分周 + 5
                ElseIf InStr(周护, "乙") > 0 Then
                    月策分周 = 月策分周 + 3
                ElseIf InStr(周护, "己") > 0 Then
                    月策分周 = 月策分周 + 0
                ElseIf InStr(周护, "丙") > 0 Then
                    月策分周 = 月策分周 - 5
                ElseIf InStr(周护, "丁") > 0 Then
                    月策分周 = 月策分周 - 4
                ElseIf InStr(周护, "戊") > 0 Then
                    月策分周 = 月策分周 - 4
                End If
        
                '盈提示调节（独立分，不叠加基础分+WXAB，直接取真实P3值，2026-08-12）
                '  高+宽: 76（P3=75.6%，样本10.4万）
                '  高(不含宽): 72（P3=71.8%，样本7.9万）
                '  宽(不含高): 68（P3=68.0%，样本19.1万）
                If InStr(周盈提, "高") > 0 And InStr(周盈提, "宽") > 0 Then
                    月策分周 = 76
                ElseIf InStr(周盈提, "高") > 0 Then
                    月策分周 = 72
                ElseIf InStr(周盈提, "宽") > 0 Then
                    月策分周 = 68
                End If
        
                '分类调节：按市板
                '  常市板基"Qe"=ETF/基金 +7
                '  常市板指"Qd"=指数 +7（与Qe同类产品）
                '  常市板票Qit"Qit"=中证2000(小盘) -3
                '  常市板票Qin"Qin"=非成分(小盘) -3
                If 周市板 = "Qe" Or 周市板 = "Qd" Then
                    月策分周 = 月策分周 + 7
                ElseIf 周市板 = "Qit" Or 周市板 = "Qin" Then
                    月策分周 = 月策分周 - 3
                End If
        
                '限幅
                If 月策分周 < 0 Then 月策分周 = 0
                If 月策分周 > 100 Then 月策分周 = 100
            Else
                '非多长区域不评分
                月策分周 = 0
            End If
        
            谕组(X, 位谕of月策分命) = 月策分命
            谕组(X, 位谕of月策略周) = 月基分类
            谕组(X, 位谕of月策分周) = 月策分周
            '============================================================================
            'V3 月策带周（周级别WXCD→WXAB带动）
            '设计思路：WXCD（大局）→WXAB（护型）双向带动
            '  输出格式：信号符 + (WXCD方向)
            '  信号：▲同上向好 / ↘反向风险 / ↗正向潜力 / ▽同下向差
            '============================================================================
            Dim V3周局 As String: V3周局 = 谕组(X, 位谕of周层大局)
            Dim V3周护 As String: V3周护 = 谕组(X, 位谕of周层护型)
            Dim V3CD金银 As Boolean: V3CD金银 = (InStr(V3周局, "金") > 0 Or InStr(V3周局, "银") > 0)
            Dim V3AB护级 As String: V3AB护级 = ""
            Dim 月策带周 As String: 月策带周 = ""
            '提取WXAB护级（上/中/下/忐/忠/忑）
            If InStr(V3周护, "上") > 0 Then V3AB护级 = "上"
            If InStr(V3周护, "中") > 0 And V3AB护级 = "" Then V3AB护级 = "中"
            If InStr(V3周护, "下") > 0 And V3AB护级 = "" Then V3AB护级 = "下"
            If InStr(V3周护, "忐") > 0 And V3AB护级 = "" Then V3AB护级 = "忐"
            If InStr(V3周护, "忠") > 0 And V3AB护级 = "" Then V3AB护级 = "忠"
            If InStr(V3周护, "忑") > 0 And V3AB护级 = "" Then V3AB护级 = "忑"
            If V3AB护级 = "" Then V3AB护级 = "?"
            Dim V3AB强 As Boolean: V3AB强 = (V3AB护级 = "上" Or V3AB护级 = "忐")

            If V3CD金银 And V3AB强 Then
                月策带周 = "▲"       '同上向好：大局+护级双强
            ElseIf V3CD金银 And Not V3AB强 Then
                月策带周 = "↘"       '反向风险：大局好但护级弱
            ElseIf Not V3CD金银 And V3AB强 Then
                月策带周 = "↗"       '正向潜力：大局差但护级强
            Else
                月策带周 = "▽"       '同下向差：双弱
            End If
            月策带周 = "(" & Mid$(V3周局, 1, 1) & ")" & 月策带周 & "(" & V3AB护级 & ")"
            谕组(X, 位谕of月策带周) = 月策带周
            '============================================================================
            'V4 月策带日（日级别三联动）— DXAB→DXCD→DXEF带动
            '设计思路：日级别三层护级串联带动效应：
            '  DXAB护级(上中下忐忠忑) → 带动 → DXCD护级(上中下忐忠忑) → 带动 → DXEF护级(金银唏嘘屎尿)
            '  DXEF护级直接用日类BT变量定义（仿WXCD护型逻辑），不依赖周值
            '  带动规则（AB→CD 与 CD→EF 同逻辑）：
            '    同上：上游∈{上,忐} 且 下游∈{上,忐}（DXEF对应：金/银=上忐级）
            '    同下：上游∈{下,忑} 且 下游∈{下,忑}（DXEF对应：唏嘘尿屎=下忑级）
            '    抬：  上游∈{上,忐} 但 下游不在{上,忐}
            '    压：  上游∈{下,忑} 但 下游不在{下,忑}
            '    待定：上游∈{中,忠}
            '============================================================================
            Dim 日AB护级 As String, 日CD护级 As String, 日EF护级 As String
            Dim 日AB促CD As String, 日CD促EF As String
            '--------------------------------------------------------------------
            '取三级护级
            '--------------------------------------------------------------------
            日AB护级 = Left$(组结算(X, 基位日类 + 位os层护级AB), 1)  '上/中/下/忐/忠/忑
            日CD护级 = Left$(组结算(X, 基位日类 + 位os层护级CD), 1)  '上/中/下/忐/忠/忑
            'DXEF护级：日类金银唏嘘尿屎（仿WXCD护型逻辑，用日类BTEF/日类BTZE/日类BTZF）
            If 日类BTEF > 0 Then
                If 日类BTZF < 0 Then
                    日EF护级 = "尿"   'BTEF>0但BTZF<0 → 走弱
                ElseIf 日类BTZE < 0 Then
                    日EF护级 = "嘘"   'BTEF>0但BTZE<0 → 混合(EF嘴)
                ElseIf 日类BTZE < 日类BTEF Then
                    日EF护级 = "金"   'BTEF>0, BTZE>0但低于BTEF → 上升中
                Else
                    日EF护级 = "金"   'BTEF>0, BTZE≥BTEF → 强升
                End If
            Else
                If 日类BTZF > 0 Then
                    日EF护级 = "银"   'BTEF≤0但BTZF>0 → 恢复中
                ElseIf 日类BTZE > 0 Then
                    日EF护级 = "唏"   'BTEF≤0但BTZE>0 → 混合(EF嘴)
                ElseIf 日类BTZE > 日类BTEF Then
                    日EF护级 = "屎"   'BTEF≤0, BTZE>BTEF → 下降中
                Else
                    日EF护级 = "屎"   'BTEF≤0, BTZE≤BTEF → 强降
                End If
            End If
            '--------------------------------------------------------------------
            'DXAB→DXCD 带动作用
            '当两级别同向，单独提示，剩余以低级别为准。
            '--------------------------------------------------------------------
            If InStr("上忐", 日AB护级) > 0 And InStr("上忐", 日CD护级) > 0 Then
                日AB促CD = "▲"       '同上
            ElseIf InStr("下忑", 日AB护级) > 0 And InStr("下忑", 日CD护级) > 0 Then
                日AB促CD = "▽"       '同下
            ElseIf InStr("上忐", 日AB护级) > 0 Then
                日AB促CD = "↗"       '抬
            ElseIf InStr("下忑", 日AB护级) > 0 Then
                日AB促CD = "↘"       '压
            Else
                日AB促CD = "○"       '待定
            End If
            '--------------------------------------------------------------------
            'DXCD→DXEF 带动作用（金银唏嘘尿屎 ←→ 上忐下忑映射）
            '当两级别同向，单独提示，剩余以低级别为准。
            '--------------------------------------------------------------------
            If InStr("上忐", 日CD护级) > 0 And InStr("金银", 日EF护级) > 0 Then
                日CD促EF = "▲"
            ElseIf InStr("下忑", 日CD护级) > 0 And InStr("尿屎", 日EF护级) > 0 Then
                日CD促EF = "▽"
            ElseIf InStr("上忐", 日CD护级) > 0 Then
                日CD促EF = "↗"
            ElseIf InStr("下忑", 日CD护级) > 0 Then
                日CD促EF = "↘"
            Else
                日CD促EF = "○"
            End If
            '--------------------------------------------------------------------
            谕组(X, 位谕of月策带日) = "(" & 日EF护级 & ")" & 日CD促EF & "(" & 日CD护级 & ")" & 日AB促CD & "(" & 日AB护级 & ")"
            '============================================================================
            '注20260726：V5 月策略日（三指标）— 查216分支概率表
            '============================================================================
            '注20260726：月策略日 = 主升/渡强/渡弱/空降 + 后缀.微(N<1000)/.小(N<10000)
            ' 月策分日P2 = 期望HR取整 + 概率等级(A-F) + 概率取整(2位)，如"4A39"
            ' 与周策分P1同样编码逻辑
            '============================================================================
            Dim 日冲pZA As Double, 日冲pDSHA1 As Double, 日冲小样本 As String
            If IQQQ跨码工具_查月策分日基程(日EF护级, 日CD护级, 日AB护级, 日冲pZA, 日冲pDSHA1, 日冲小样本) Then
                '月策分日P2编码
                Dim 月策分日P2编码 As String: 月策分日P2编码 = IQQQ跨码工具_查月策分日P2(日EF护级, 日CD护级, 日AB护级, 周市板)
                If 月策分日P2编码 = "" Then
                    谕组(X, 位谕of月策分日P2) = "_"
                Else
                    '20260815：第二位改为G/_标识是否高于基线。月策分日P2基线=30（查表概率下限）。G=下日冲高≥2%概率≥30，_=低于下限
                    Dim 月策分日P2取整 As Integer: 月策分日P2取整 = Val(Mid$(月策分日P2编码, 3, 2))
                    If 月策分日P2取整 > 0 Then
                        If 月策分日P2取整 >= 30 Then
                            谕组(X, 位谕of月策分日P2) = Left$(月策分日P2编码, 1) & "G" & Mid$(月策分日P2编码, 3)
                        Else
                            谕组(X, 位谕of月策分日P2) = Left$(月策分日P2编码, 1) & "_" & Mid$(月策分日P2编码, 3)
                        End If
                    Else
                        谕组(X, 位谕of月策分日P2) = "_"
                    End If
                End If
                ' 月策略日：龙(金银)/雀(唏)/虎(嘘)/武(屎尿) + 强(上中忐)/弱(下忠忑)
                Dim 月策略日分类 As String
                Dim 月策略日强弱 As String
                If 日CD护级 = "上" Or 日CD护级 = "中" Or 日CD护级 = "忐" Then
                    月策略日强弱 = "强"
                Else
                    月策略日强弱 = "弱"
                End If
                月策略日分类 = ""
                ' 格式: A-H(等级) + 强弱 + 好/坏(AB) + 主/被/傻/禁(层级)
                ' 忠特殊处理: 嘘尿屎+忠+全部AB → G级
                Dim 月策略日AB As String
                If 日AB护级 = "上" Or 日AB护级 = "中" Or 日AB护级 = "忐" Then
                    月策略日AB = "好"
                Else
                    月策略日AB = "坏"
                End If
                If 日EF护级 = "金" Or 日EF护级 = "银" Or 日EF护级 = "唏" Then
                    'EF好(金银唏)
                    If 月策略日强弱 = "强" Then
                        If 月策略日AB = "好" Then
                            月策略日分类 = "A" & 月策略日强弱 & "好主"  'A级: 主(主动持仓)
                        Else
                            月策略日分类 = "B" & 月策略日强弱 & "好被"  'B级: 被(被动持有)
                        End If
                    Else
                        If 月策略日AB = "好" Then
                            月策略日分类 = "C" & 月策略日强弱 & "好被"  'C级: 被(被动持有)
                        Else
                            月策略日分类 = "D" & 月策略日强弱 & "坏被"  'D级: 被(被动持有)
                        End If
                    End If
                Else
                    'EF差(嘘/屎/尿)
                    If 日CD护级 = "忠" Then
                        月策略日分类 = "G" & 月策略日强弱 & 月策略日AB & "傻"  '忠特殊: 全部AB归G级(傻)
                    ElseIf 月策略日强弱 = "强" Then
                        If 月策略日AB = "好" Then
                            月策略日分类 = "E" & 月策略日强弱 & "好主"  'E级: 主(主动持仓)
                        Else
                            月策略日分类 = "F" & 月策略日强弱 & "坏被"  'F级: 被(被动持有)
                        End If
                    Else
                        '弱(下/忑)
                        If 月策略日AB = "好" Then
                            月策略日分类 = "G" & 月策略日强弱 & "好傻"  'G级: 傻(傻吃屎豆)
                        Else
                            月策略日分类 = "H" & 月策略日强弱 & "坏禁"  'H级: 禁(禁止)
                        End If
                    End If
                End If
                ' 小样本追加后缀
                If 日冲小样本 <> "" Then
                    月策略日分类 = 月策略日分类 & 日冲小样本
                End If
                谕组(X, 位谕of月策略日) = 月策略日分类
            Else
                谕组(X, 位谕of月策略日) = "无数据"
                '日策分P2由等高线后策略映射赋值，此处不覆盖
                谕组(X, 位谕of月策分日P2) = "_"
            End If
            '============================================================================
            '虚拟权重（@20240111：不要更改。可以不持有，但不要重仓或过快砍仓）
            '思路：仅利用系统性重要均线WXCD决定权重，具体操作由非权重指标（WJCBA、BTZA、触顶、叭宽）决定。
            '不利用次级均线决定权重的原因是：
            '   （1）重要性不足：单柱上穿或下破JBJA不应引起权重变化。逃顶应在更高位置进行。
            '   （2）混淆权重：处于（哼JA管）时，触顶应该止盈，而下跌w2d应该买入。这两种情况单纯以WJA为权重无法区分。
            '   （3）勿入空头：在WJBCD空头排列时，如关注上破JAJB，可能误入空头。这种利润是庄家的菜，不是我应该吃的。
            '   （4）趋势形态：应为小碎步堆积形成的左右运动；不应为阴阳交错的上下运动。单纯以均线上下关系无法识别，所以放弃次级均线。
            '============================================================================
                    '--------------------------------------------------------------------
                    '废弃仓权重：WXCD仓位控制
                    '--------------------------------------------------------------------
                    '谕组(X, 位谕of仓限倍) = IIf(周类BTCD > 0, 1, -1) + IIf(周类BTZD > 0, 1, -1) + IIf(周类BTZC > 0, 1, -1)
                    '--------------------------------------------------------------------
                    '注20240901：改为按照周线进行仓位控制。变化范围：1-5。减至3仓位；清至1仓位。5以上为附加仓位。
                    '柱20241001：为了保证持仓操作简化稳定，放弃复杂调仓。仅仅按照WXBC进行设置，当WXAC>0开始全仓，破WJB减仓，破WJC清仓。
                    '--------------------------------------------------------------------
                    '谕组(X, 位谕of仓限倍) = 0
                    'If Left$(谕组(X, 位谕of周层护型), 1) = "×" Then
                    '        谕组(X, 位谕of仓限倍) = 0
                    'ElseIf InStr(谕组(X, 位谕of周层护型), "魅") > 0 Then  '底仓
                    '        谕组(X, 位谕of仓限倍) = 3
                    'ElseIf InStr(谕组(X, 位谕of周层护型), "魑") > 0 Then  '底仓
                    '        谕组(X, 位谕of仓限倍) = 2
                    'Else
                    '        谕组(X, 位谕of仓限倍) = 5
                    'End If
                    '--------------------------------------------------------------------
                    '注20241024：仓位管理。在DJEDC之上，在DJB之上可加1浮仓，保留1底仓；在DJEDC之下无仓。
                    '注20241124：周类不符合肯定不要进入；WJC之上以WJB作为止损线，确定操作范围；用DJE之上DJC替代WJC。
                    '注20241115：处于DJE&DJC之上，且管宽小于20的范围内，仓限为3；跌破DJE&DJC，或高于DJC*1.2，都需减至底仓。另，如触顶或收阳柱，也应减至底仓；等站稳有机会再加浮仓，冲高后再减至底仓；只是在此处不限制仓位阈值。
                    '--------------------------------------------------------------------
                    '谕组(X, 位谕of仓限倍) = 0
                    'If Left$(谕组(X, 位谕of周层界), 1) = "_" Then
                    '        谕组(X, 位谕of仓限倍) = 0
                    'ElseIf 日类BTZE > 0 And 日类BTZC > 0 Then
                    '    '注20241115：处于DJE&DJC之上，且管宽小于20的范围内，仓限为3；跌破DJE&DJC，或高于DJC*1.2，都需减至底仓。另，如触顶或收阳柱，也应减至底仓；等站稳有机会再加浮仓，冲高后再减至底仓；只是在此处不限制仓位阈值。
                    '    If 谕组(X, 位谕of日层宽哼JC) < 20 Then
                    '        谕组(X, 位谕of仓限倍) = 3   '代表底仓+浮仓（暂定2倍底仓）
                    '        '如果是劫BCD也要限制仓位
                    '    Else
                    '        谕组(X, 位谕of仓限倍) = 1 '代表底仓
                    '    End If
                    'ElseIf 日类BTZD < 0 Then
                    '        谕组(X, 位谕of仓限倍) = 0
                    'Else
                    '        谕组(X, 位谕of仓限倍) = 1 '代表底仓
                    '        '注20241119：一般情况，WJC为生死线，WJB为病危线。在下破WJB后可以清仓；在日线级别，处于DJE与DJC之下，但在WJB之上，给与底仓。
                    'End If
                    '--------------------------------------------------------------------
                    '与 月策略日保持一致
                    '--------------------------------------------------------------------
                    '位谕of仓限倍：按月策略日末位(第4位)设置：禁=0, 傻=1, 被=2, 主=4
                    谕组(X, 位谕of仓限倍) = 0
                    If Mid$(谕组(X, 位谕of月策略日), 4, 1) = "主" Then
                            谕组(X, 位谕of仓限倍) = 4
                    ElseIf Mid$(谕组(X, 位谕of月策略日), 4, 1) = "被" Then
                            谕组(X, 位谕of仓限倍) = 2
                    ElseIf Mid$(谕组(X, 位谕of月策略日), 4, 1) = "傻" Then
                            谕组(X, 位谕of仓限倍) = 1
                    '末位"禁"或"无数据"时保持0
                    End If
            '============================================================================
            '============================================================================
            '等高线分类：等1~等7（6等），基于DTZA(日ZA)+日中符(中符串)末位
            ' 等1: DTZA=1, 任意末位     → DJA边缘刚站上
            ' 等2: DTZA≥2, 末位CDEF    → 原等2+等4合并，含回归DJA+软弱
            ' 等3: DTZA≥2, 末位AB      → 远离DJA强势主升
            ' 等5: DTZA=-1, 任意末位    → DJA边缘下方
            ' 等6: DTZA≤-2, 末位ABCD   → 原等6+等8合并，含回归+近DJA偏强
            ' 等7: DTZA≤-2, 末位EF     → 远离DJA弱势
            '注：末位=Right$(中符串,1)，仅看当前柱。VBA末位逻辑，6等简化版（2026-08-12）。
            '============================================================================
            Dim 等日ZA As Double: 等日ZA = 组结算(X, 基位日类 + 位osBTZA)
            Dim 等日中符 As String: 等日中符 = 谕组(X, 位谕of日管中符串)
            Dim 等日末符 As String: 等日末符 = Right$(等日中符, 1)  '仅看最后一位(当前柱)
            Dim 等值 As String: 等值 = ""
            If 等日ZA = 1 Then
                等值 = "等1"  'DJA边缘刚站上
            ElseIf 等日ZA > 0 Then
                '上侧：DTZA≥2时，根据日中符末位区分AB(强)和CDEF(弱)
                If 等日ZA >= 2 And InStr("AB", 等日末符) > 0 Then
                    等值 = "等3"  '远离DJA强势主升
                ElseIf 等日ZA >= 2 And InStr("CDEF", 等日末符) > 0 Then
                    等值 = "等2"  '原等2+等4合并：近DJA软弱~回归DJA
                End If
            ElseIf 等日ZA = -1 Then
                等值 = "等5"  'DJA边缘下方
            ElseIf 等日ZA < 0 Then
                '下侧：镜面映射 A<>F, B<>E, C<>D
                If 等日ZA <= -2 And InStr("EF", 等日末符) > 0 Then
                    等值 = "等7"  '远离DJA弱势
                ElseIf 等日ZA <= -2 And InStr("ABCD", 等日末符) > 0 Then
                    等值 = "等6"  '原等6+等8合并：近DJA偏强~回归
                End If
            End If
            谕组(X, 位谕of日层等) = 等值
                        '============================================================================
            '日策略P2（市板过滤 + 周门 + 等高线 + 条件评分）
            ' 输出：策略名(等级+等+数字+条件) + 策分(H2整数)
            ' 核心池：Qic/Qim/Qit，排除Qd/Qe/Qif/Qst/Qin
            '============================================================================
            谕组(X, 位谕of日策略P2) = ""
            谕组(X, 位谕of日策分P2) = "_"
            '第1级：市板过滤 — 非核心池跳过
            Dim 值市板 As String: 值市板 = 谕组(X, 位qt市板)
            If 值市板 = "" Then 值市板 = IQQQ跨码工具_获取单码市板(CIDL)
            If 值市板 <> "Qd" And 值市板 <> "Qe" And 值市板 <> "Qif" And 值市板 <> "Qst" And 值市板 <> "Qin" Then
                '核心池，继续周门过滤
                If 日类BTZC > 0 And 日类BTCD > 0 Then  '第2级：周门
                    Dim 等BSHA As Double: 等BSHA = Val(谕组(X, 位谕of日层BSHA))
                    Dim 等连阳 As Long: 等连阳 = Val(谕组(X, 位谕of日层BT连阳))
                    Dim 等层主 As String: 等层主 = 谕组(X, 位谕of日层界)
                    Dim 等柱排 As String: 等柱排 = 谕组(X, 位谕of日层柱排)
                    Dim 等BSHA5 As Boolean: 等BSHA5 = (等BSHA > 5)
                    Dim 等BSHA3 As Boolean: 等BSHA3 = (等BSHA > 3)
                    Dim 等连阳2 As Boolean: 等连阳2 = (等连阳 > 0)
                    Dim 等层主2 As Boolean: 等层主2 = (Left$(等层主, 1) = "主")
                    Dim 等升排2 As Boolean: 等升排2 = (Left$(等柱排, 1) = "升")
                    Dim 等跌排2 As Boolean: 等跌排2 = (Left$(等柱排, 1) = "跌")
                    Dim 等策略名 As String: 等策略名 = ""
                    Dim 等策分 As Double: 等策分 = 0
                    '第3级：等高线 + 第4级：条件评分
                    If 等值 = "等3" Then
                        If 等BSHA5 And 等连阳2 Then
                            等策略名 = "等3.偏5连门": 等策分 = 58
                        ElseIf 等BSHA5 Then
                            等策略名 = "等3.偏5": 等策分 = 54
                        ElseIf 等BSHA3 And 等连阳2 Then
                            等策略名 = "等3.偏3连门": 等策分 = 53
                        ElseIf 等连阳2 Then
                            等策略名 = "等3.连": 等策分 = 49
                        ElseIf 等层主2 Then
                            等策略名 = "等3.层主": 等策分 = 44
                        ElseIf 等跌排2 Then
                            等策略名 = "等3.跌排": 等策分 = 37
                        End If
                    ElseIf 等值 = "等1" Then
                        If 等BSHA5 And 等连阳2 Then
                            等策略名 = "等1.偏5连门": 等策分 = 61
                        ElseIf 等BSHA5 Then
                            等策略名 = "等1.偏5": 等策分 = 56
                        ElseIf 等层主2 Then
                            等策略名 = "等1.层主": 等策分 = 44
                        End If
                    ElseIf 等值 = "等2" Then
                        If 等BSHA5 And 等连阳2 Then
                            等策略名 = "等2.偏5连门": 等策分 = 58
                        ElseIf 等BSHA5 Then
                            等策略名 = "等2.偏5": 等策分 = 57
                        ElseIf 等BSHA3 And 等连阳2 Then
                            等策略名 = "等2.偏3连门": 等策分 = 53
                        ElseIf 等BSHA3 Then
                            等策略名 = "等2.偏3": 等策分 = 51
                        ElseIf 等连阳2 Then
                            等策略名 = "等2.连": 等策分 = 48
                        ElseIf 等层主2 And 等升排2 Then
                            等策略名 = "等2.层主升": 等策分 = 45
                        ElseIf 等升排2 Then
                            等策略名 = "等2.升": 等策分 = 40
                        ElseIf 等跌排2 Then
                            等策略名 = "等2.跌排": 等策分 = 39
                        End If
                    ElseIf 等值 = "等5" Then
                        If 等BSHA5 Then
                            等策略名 = "等5.偏5": 等策分 = 61
                        ElseIf 等BSHA3 Then
                            等策略名 = "等5.偏3": 等策分 = 53
                        End If
                    ElseIf 等值 = "等6" Then
                        If 等BSHA5 Then
                            等策略名 = "等6.偏5": 等策分 = 52
                        ElseIf 等BSHA3 Then
                            等策略名 = "等6.偏3": 等策分 = 49
                        End If
                    ElseIf 等值 = "等7" Then
                        If 等BSHA5 Then
                            等策略名 = "等7.偏5": 等策分 = 54
                        ElseIf 等BSHA3 Then
                            等策略名 = "等7.偏3": 等策分 = 51
                        End If
                    End If
                    '写入策略名和策分（从查表文件读取编码）
                    If 等策略名 <> "" Then
                        谕组(X, 位谕of日策略P2) = IQQQ跨码工具_日冲等级(等策分) & 等策略名
                        Dim 日策分P2编码 As String: 日策分P2编码 = IQQQ跨码工具_查日策分P2(等策略名)
                        If 日策分P2编码 = "" Then
                            谕组(X, 位谕of日策分P2) = "_"
                        Else
                            '20260815：第二位改为G/_标识是否高于基线。P2基线=50（评分阈值，非概率）。G=评分≥50(B级)，_=低于50。注意：数值是评分(37~61)非概率
                            Dim 日P2取整 As Integer: 日P2取整 = Val(Mid$(日策分P2编码, 3, 2))
                            If 日P2取整 > 0 Then
                                If 日P2取整 >= 50 Then
                                    谕组(X, 位谕of日策分P2) = Left$(日策分P2编码, 1) & "G" & Mid$(日策分P2编码, 3)
                                Else
                                    谕组(X, 位谕of日策分P2) = Left$(日策分P2编码, 1) & "_" & Mid$(日策分P2编码, 3)
                                End If
                            Else
                                谕组(X, 位谕of日策分P2) = "_"
                            End If
                        End If
                    Else
                        '20260815：策略名为空时，策分也设为_（统一）
                        谕组(X, 位谕of日策分P2) = "_"
                    End If
                End If
            End If
'============================================================================
            '日层段（仓位状态）
            '定义：DXZE>0为前提，再按DXZC/DXZA细分（2026-08-17全量验证）
            '  持主 = DXZE>0+DXZC>0+DXZA>0（三线全上，期望HR=2.19%，P3=25.4%）
            '  持被 = DXZE>0+DXZC>0+DXZA<=0（ZE/ZC上，ZA下，期望HR=2.0%）
            '  卖浮 = DXZE>0+DXZC<=0（ZE上，ZC下，期望HR=1.76%）
            '  持主+BSHA>=5+触顶 = 期望HR=3.42%（最强组合，接近必赢但非100%）
            '============================================================================
            谕组(X, 位谕of日层段) = "NA"
            If 日类BTZE > 0 Then
                If 日类BTZC <= 0 Then
                    谕组(X, 位谕of日层段) = "卖浮"
                ElseIf 日类BTZA > 0 Then
                    谕组(X, 位谕of日层段) = "持主"
                Else
                    谕组(X, 位谕of日层段) = "持被"
                End If
            End If
            '日层段期：min(DTZE, DTZC)，当前已持有天数
            If 日类BTZE > 0 And 日类BTZC > 0 Then
                谕组(X, 位谕of日层段期) = IIf(日类BTZE < 日类BTZC, 日类BTZE, 日类BTZC)
            Else
                谕组(X, 位谕of日层段期) = 0
            End If
            '============================================================================
            '日层赢：综合DXZE×DXCD×DXAB，先定第2位分类，再按DXZE加前缀
            '  DXCD上/忐/忠 + 日层界储/初 → 介A/介B
            '  DXCD上/忐/忠 + 其他 → 持A/持B
            '  DXCD中 → 参A/参B
            '  DXCD下/忑 或 数据异常 → _弃
            '  A/B后缀：DXAB∈{甲乙己}→A，其他→B
            '  分组依据（全量2000万行验证）：
            '    甲乙己一组：DXZC>0全部正收益，己+2.64%/84.2%，甲+1.12%/60.1%，乙+0.56%/53.8%
            '    其他一组：丙所有条件负收益，丁+0.16%被动，戊+0.67%试仓，乙(ZA<0)脆弱平衡
            '  非"_弃"且 DXZE<0 → 加前缀 _
            '============================================================================
            Dim 值日层赢 As String: 值日层赢 = ""
            Dim 日层护型 As String: 日层护型 = 谕组(X, 位谕of日层护型)
            Dim DXAB护段 As String
            If Len(日层护型) >= 2 Then DXAB护段 = Mid$(日层护型, 2, 1)
            'DXCD护级从 位谕of月策带日 第2个括号提取（结构：(EF)X(CD)Y(AB)）
            Dim 月策带日段() As String: 月策带日段 = Split(谕组(X, 位谕of月策带日), "(")
            If UBound(月策带日段) >= 2 Then 日CD护级 = Left$(月策带日段(2), 1)

            '异常处理：月策带日格式异常或DXCD护级为空 → _弃
            If 日CD护级 = "" Then
                值日层赢 = "_弃"
            Else
                '第2位：综合分类
                If InStr("上忐忠", 日CD护级) > 0 Then
                    If Left$(谕组(X, 位谕of日层界), 1) = "储" Or Left$(谕组(X, 位谕of日层界), 1) = "初" Then
                        值日层赢 = "介"
                    Else
                        值日层赢 = "持"
                    End If
                    值日层赢 = 值日层赢 & IIf(InStr("甲乙己", DXAB护段) > 0, "A", "B")
                ElseIf 日CD护级 = "中" Then
                    值日层赢 = "参"
                    值日层赢 = 值日层赢 & IIf(InStr("甲乙己", DXAB护段) > 0, "A", "B")
                Else
                    值日层赢 = "_弃"
                End If
                '前缀：非"_弃"且 DXZE<0 加 "_"
                If 值日层赢 <> "_弃" And 日类BTZE < 0 Then
                    值日层赢 = "_" & 值日层赢
                End If
            End If
            谕组(X, 位谕of日层赢) = 值日层赢
            '============================================================================
            '等高线机警（供筛选直接读取，避免组结算引用）
            '没有必要单独输出，<日层机警>只用于参考。
            '============================================================================
            Dim 等机警 As String: 等机警 = ""
            Dim 等顶型 As String: 等顶型 = 组结算(X, 基位日类 + 位os基顶型)
            Dim 等上符 As String: 等上符 = 谕组(X, 位谕of日管上符串)
            '--- 等3龙头：等3+ZC>0+顶型含龙+上符末位A ---
            If 等值 = "等3" And 日类BTZC > 0 Then
                If InStr(等顶型, "龙") > 0 And Right$(等上符, 1) = "A" Then
                    等机警 = "等3顶"
                Else
                    等机警 = "等3"
                End If
            '--- 开门：ZC>0+CD>0（无条件叠加） ---
            ElseIf 日类BTZC > 0 And 日类BTCD > 0 Then
                等机警 = "开门"
            End If
            谕组(X, 位谕of日层机警) = 等机警
            '============================================================================
'@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
'策传
'@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
            '============================================================================
            '============================================================================
            '策传综合信息（积木拼搭式）- 每块独立生成，最后组装
            '============================================================================
            '============================================================================
            Dim 程策传_四域 As String, 程策传_日级 As String
            Dim 程策传_波形 As String, 程策传_机阱 As String, 程策传_冲高 As String
            '积木①：四域+WXAB+WTAB
            程策传_四域 = "四域=" & 谕组(X, 位谕of周层四域)
            程策传_四域 = 程策传_四域 & " WXAB=" & 谕组(X, 位谕of周层护型)
            程策传_四域 = 程策传_四域 & " AB周=" & CStr(谕组(X, 位谕of周类BTAB))
            程策传_四域 = 程策传_四域 & " ZC=" & CStr(谕组(X, 位谕of日类BTZC))
            程策传_四域 = 程策传_四域 & " ZE=" & CStr(谕组(X, 位谕of日类BTZE))

            '积木②：日级别（仓日类+日层段+信号+漏提示）
            程策传_日级 = "仓日=" & 谕组(X, 位谕of仓日类)
            程策传_日级 = 程策传_日级 & " 策略=" & 谕组(X, 位谕of日策略P2)
            程策传_日级 = 程策传_日级 & " 日信号=" & 谕组(X, 位谕of日层机警)
            程策传_日级 = 程策传_日级 & " 漏=" & 谕组(X, 位谕of日层漏提示)

            '积木③：波形+柱排（周+日）
            程策传_波形 = "周波=" & 谕组(X, 位谕of周层波型)
            程策传_波形 = 程策传_波形 & " 周柱=" & 谕组(X, 位谕of周层柱排)
            程策传_波形 = 程策传_波形 & " 日波=" & 谕组(X, 位谕of日层波型)
            程策传_波形 = 程策传_波形 & " 日柱=" & 谕组(X, 位谕of日层柱排)

            '积木④：盈提示+机阱
            程策传_机阱 = "盈=" & 谕组(X, 位谕of周层盈提示) & "/" & 谕组(X, 位谕of日层盈提示)
            程策传_机阱 = 程策传_机阱 & " 龄=" & CStr(谕组(X, 位谕of周波龄BTPR0))
            程策传_机阱 = 程策传_机阱 & " 涨幅=" & CStr(谕组(X, 位谕of周波今涨幅))

            '积木⑤：冲高信号
            程策传_冲高 = "周策略P1=" & 谕组(X, 位谕of周策略P1) & " 策分P1=" & 谕组(X, 位谕of周策分P1)
            程策传_冲高 = 程策传_冲高 & " 周策略P3=" & 谕组(X, 位谕of周策略P3) & " 策分P3=" & 谕组(X, 位谕of周策分P3)
            程策传_冲高 = 程策传_冲高 & " 临涨=" & CStr(谕组(X, 位谕of周波临涨幅))
            程策传_冲高 = 程策传_冲高 & " 周层局=" & 谕组(X, 位谕of周层大局)

            '组装：5块积木拼接
            谕组(X, 位谕of策传) = 程策传_四域 & " | " & 程策传_日级 & " | " & 程策传_波形 & " | " & 程策传_机阱 & " | " & 程策传_冲高
            '============================================================================
'@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
            
            
            
            
            
'@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
'########################################################################################
'########################################################################################
'跨码管理（仓位管理 + 跨码基础）
'从神谕剥离至 IQQQ跨码_D据擎4跨码管理.bas
'########################################################################################
'########################################################################################
    If 是否跨码 = True Then
        Call IQQQ跨码据擎_数程生成跨码管理(谕组, 组结算, X, 基列)
    End If
'########################################################################################
'########################################################################################
'测试系统
'########################################################################################
'########################################################################################
            '============================================================================
            '============================================================================
'########################################################################################
'########################################################################################
End If
Next
'========================================================================================
'返回
End Function








'========================================================================================
'========================================================================================
'功能：
'以下指标原来在神谕中衍生，但在不同周期适用相同逻辑，放在此处仅仅为提高效率。
'衍生结点：由于指标仅依赖于单条数据，可以在最后一个结点再调用提高效率。
'========================================================================================
'========================================================================================
Function STBASE结算引擎_单点衍生核程(ByRef ARROS As Variant) As Integer
'########################################################################################
'##################################     工具衍生     ####################################
'##################################   工具衍生指标   ####################################
'########################################################################################
            '============================================================================
            '并符串：范
            '功能：用于对A5进行五柱二阴判断。一定要注意，仅适用于极端A5情况。
            '============================================================================
                ARROS(位os具并符范) = 0
                If Len(ARROS(位os具并符串)) = 5 Then
                    For i = 1 To 5
                        值具并符单形 = Mid(ARROS(位os具并符串), i, 1)
                        Select Case 值具并符单形
                        Case 常枚并符跌连, 常枚并符跌吞, 常枚并符跌孕
                            ARROS(位os具并符范) = ARROS(位os具并符范) + 1
                        End Select
                    Next
                End If
            '============================================================================
            '中符串：范
            '============================================================================
                Dim 值具中符范 As Integer
                ARROS(位os具中符范) = 0
                ARROS(位os具中符数A) = 0
                ARROS(位os具中符数B) = 0
                ARROS(位os具中符数C) = 0
                ARROS(位os具中符数D) = 0
                If Len(ARROS(位os具中符串)) = 5 Then
                    For i = 1 To 5
                        值单形中符 = Mid(ARROS(位os具中符串), i, 1)
                        Select Case 值单形中符
                        Case 常枚中符上全
                            值具中符范 = 1000
                            ARROS(位os具中符数A) = ARROS(位os具中符数A) + 1
                        Case 常枚中符上探
                            值具中符范 = 100
                            ARROS(位os具中符数B) = ARROS(位os具中符数B) + 1
                        Case 常枚中符鼎正
                            值具中符范 = 10
                            ARROS(位os具中符数C) = ARROS(位os具中符数C) + 1
                        Case 常枚中符薡反
                            值具中符范 = 1
                            ARROS(位os具中符数D) = ARROS(位os具中符数D) + 1     '反鼎不作为上壁考虑的有利因素
                        Case Else
                            值具中符范 = 0
                        End Select
                        ARROS(位os具中符范) = ARROS(位os具中符范) + CInt(值具中符范)
                    Next
                End If
            '============================================================================
            '上符串：范
            '============================================================================
                ARROS(位os具上符数触顶) = 0
                ARROS(位os具上符数触哼) = 0
                ARROS(位os具上符数触哈) = 0
                ARROS(位os具上符数触底) = 0
                If Len(ARROS(位os具上符串)) = 5 Then
                    For i = 1 To 5
                        值单符上壁形 = Mid(ARROS(位os具上符串), i, 1)
                        If 值单符上壁形 = 常枚上符顶 Then
                            ARROS(位os具上符数触顶) = ARROS(位os具上符数触顶) + 1
                            ARROS(位os具上符数触哼) = ARROS(位os具上符数触哼) + 1
                        ElseIf 值单符上壁形 = 常枚上符哼 Then
                            ARROS(位os具上符数触哼) = ARROS(位os具上符数触哼) + 1
                        ElseIf 值单符上壁形 = 常枚上符哈 Then
                            ARROS(位os具上符数触哈) = ARROS(位os具上符数触哈) + 1
                        ElseIf 值单符上壁形 = 常枚上符底 Then
                            ARROS(位os具上符数触底) = ARROS(位os具上符数触底) + 1
                            ARROS(位os具上符数触哈) = ARROS(位os具上符数触哈) + 1
                        End If
                    Next
                End If
                '------------------------------------------------------------------------
                '要求：最低要求大于200（排除单柱触哼）
                值具上符范 = 0
                If ARROS(位osBTZC) > 0 Then
                    值具上符范 = 值具上符范 + 10 * IIf(ARROS(位os龟BT哼) > 0, ARROS(位os龟BT哼), 0)
                    值具上符范 = 值具上符范 + 1 * ARROS(位os具上符数触哼)
                ElseIf ARROS(位osBTZC) < 0 Then
                    值具上符范 = 值具上符范 + 10 * IIf(ARROS(位os龟BT哈) > 0, ARROS(位os龟BT哈), 0)
                    值具上符范 = 值具上符范 + 1 * ARROS(位os具上符数触哈)
                End If
                ARROS(位os具上符范) = 值具上符范
            '============================================================================
            '具幅符串
            '============================================================================
                值具当高符 = ""
                值具当涨符 = ""
                值具当低符 = ""
                ARROS(位os具幅符串) = ""
                For i = 2 To 0 Step -1
                        值具当高幅 = ARROS(位os结幅HR0 + i)
                        值具当涨幅 = ARROS(位os结幅PR0 + i)
                        值具当低幅 = ARROS(位os结幅LR0 + i)
                        '------------------------------------------------------------
                        Select Case 值具当高幅
                        Case Is >= 20
                            值具当高符 = "Z"
                        Case Is >= 10
                            值具当高符 = "Y"
                        Case Is >= 5
                            值具当高符 = "B"
                        Case Is >= 1
                            值具当高符 = "A"
                        Case Is >= 0
                            值具当高符 = "O"
                        Case Is >= -1
                            值具当高符 = "o"
                        Case Is >= -5
                            值具当高符 = "a"
                        Case Is >= -10
                            值具当高符 = "b"
                        Case Is >= -20
                            值具当高符 = "y"
                        Case Else
                            值具当高符 = "z"
                        End Select
                        '------------------------------------------------------------
                        Select Case 值具当涨幅
                        Case Is >= 20
                            值具当涨符 = "Z"
                        Case Is >= 10
                            值具当涨符 = "Y"
                        Case Is >= 5
                            值具当涨符 = "B"
                        Case Is >= 1
                            值具当涨符 = "A"
                        Case Is >= 0
                            值具当涨符 = "O"
                        Case Is >= -1
                            值具当涨符 = "o"
                        Case Is >= -5
                            值具当涨符 = "a"
                        Case Is >= -10
                            值具当涨符 = "b"
                        Case Is >= -20
                            值具当涨符 = "y"
                        Case Else
                            值具当涨符 = "z"
                        End Select
                        '------------------------------------------------------------
                        Select Case 值具当低幅
                        Case Is >= 20
                            值具当低符 = "Z"
                        Case Is >= 10
                            值具当低符 = "Y"
                        Case Is >= 5
                            值具当低符 = "B"
                        Case Is >= 1
                            值具当低符 = "A"
                        Case Is >= 0
                            值具当低符 = "O"
                        Case Is >= -1
                            值具当低符 = "o"
                        Case Is >= -5
                            值具当低符 = "a"
                        Case Is >= -10
                            值具当低符 = "b"
                        Case Is >= -20
                            值具当低符 = "y"
                        Case Else
                            值具当低符 = "z"
                        End Select
                        '------------------------------------------------------------
                        ARROS(位os具幅符串) = ARROS(位os具幅符串) & 值具当低符 & 值具当高符 & 值具当涨符 & " "
                Next
            '============================================================================
            '衍生：锚系统
            '依赖：均线交叉累期系统
            '============================================================================
                If ARROS(位osBTZD) = 1 Then
                    ARROS(位os具锚ZD) = ARROS(位osJD)
                ElseIf ARROS(位osBTZD) < 0 Then
                    ARROS(位os具锚ZD) = 0
                End If
                '--------------------------------------------------------
                If ARROS(位osBTZC) = 1 Then
                    ARROS(位os具锚ZC) = ARROS(位osJC)
                ElseIf ARROS(位osBTZC) < 0 Then
                    ARROS(位os具锚ZC) = 0
                End If
            '============================================================================
'########################################################################################
'##################################     工具衍生     ####################################
'##################################   工具衍生指标   ####################################
'########################################################################################



'########################################################################################
'##################################     中观衍生     ####################################
'##################################   横类衍生指标   ####################################
'########################################################################################
            '============================================================================
            '横类
            '主要原则：区分【鸡蛋挑骨头】与【沙子里淘金】
            '思路20210921：
            '   理论上，当JZ上破JC时进入，当JZ下破JC时退出，可以将这一过程视为一个黑盒，在整个过程中不进行干预。
            '   但是由于可能存在上涨过快调整，或小碎步撤退的情况，可能造成利润回撤，因此在某些特殊情况下应进行干预。
            '   减仓操作的目的是以更好的心态守住持仓；加仓操作的目的是加厚利润。切记千万不要重仓押注，即使该股票非常好。
            '醍醐灌顶20220312：
            '   横向操盘主要由两个变量进行总分控制：横类、竖类。注意两点：（横）不要被（竖）打乱，所以在（竖类）中不要出现（竖）的内容，只依赖均线的情况。大局把握放在（横类），将偏大警示放在（横类）中。
            '醍醐灌顶20230703：
            '   核心思想：对WJABC排列进行分类，核心是JB与JC关系，分为[a多b劫y运z空]/a多头排列/b劫/y运/z空头排列，后两位代表主导横向形态，末位代表是否在WJB之上（即是否在小通道中）。【u】代表大于JB，【v】代表小于JB，存在人为强制的情况。
            '   命名规则：前缀【入】非多头排列；【始】代表横y系；【试】代表空头排列；【继】代表横b系；【再】代表ZB劫；前缀【安（天劫）】【多（ZA劫/ZB劫/其他劫）】多头排列；
            '============================================================================
            值局类 = ARROS(位os局ZABC)
            值横类 = ""
            '----------------------------------------------------------------------------
            '正向JC以上
            '----------------------------------------------------------------------------
            If ARROS(位osBTZC) > 0 Then
                    '--------------------------------------------------------------------
                    '阶段：【BC劫】残局
                    '--------------------------------------------------------------------
                    If 值局类 = "1b" Or 值局类 = "1e" Then
                                值横类 = "yACu_入始"
                    ElseIf 值局类 = "1w" Then
                                值横类 = "yABu_入始"
                    ElseIf 值局类 = "1v" Then
                                值横类 = "zZBu_入试"
                    '--------------------------------------------------------------------
                    '阶段：【BA劫】残局
                    '醍醐灌顶20220601：取消ZC劫分类，仅保留BA劫、CA劫。
                    '--------------------------------------------------------------------
                    ElseIf 值局类 = "3u" Or 值局类 = "2i" Then
                                值横类 = "bCAu_入继"
                    ElseIf 值局类 = "3h" Or 值局类 = "2I" Then
                                值横类 = IIf(ARROS(位osBTAC) <= 5, "bCAu_入继", "bBAu_入继")
                    ElseIf 值局类 = "3w" Then
                                值横类 = "bBAv_出始"
                    '--------------------------------------------------------------------
                    '阶段：【BZ劫】残局
                    '醍醐灌顶20220820：3v不必退出
                    '已解决问题20240115：是否将3v放入多头排列之中。参考【友邦吊顶20140620】。不要分散3v，集中展示比较好。不需要再讨论这个问题。
                    '--------------------------------------------------------------------
                    ElseIf 值局类 = "3v" Then
                                值横类 = "aBZv_出试"
                    '--------------------------------------------------------------------
                    '以下针对2c/2d/2e
                    '前缀多：代表WJABC多头排列
                    '--------------------------------------------------------------------
                    Else
                            '------------------------------------------------------------
                            '阶段：【BC劫】彻底调整，必须放到最前面
                            '以下状态：2c/2d/2e
                            If ARROS(位osBTBC) <= 4 Then        '
                                    值横类 = "aACu_多始"
                            ElseIf ARROS(位osBTAB) <= 4 Then
                                    值横类 = IIf(ARROS(位osBTAC) <= 9, "aCAu_多继", "aBAu_多继")
                            '------------------------------------------------------------
                            ElseIf 值局类 = "2e" Then
                                    值横类 = IIf(ARROS(位osBTZB) <= 5, "aBZu_多Be", "aAZu_多Ae")
                            '------------------------------------------------------------
                            '以下状态：2c/2d
                            ElseIf ARROS(位osBTZA) <= 4 Then
                                If ARROS(位osBTZB) <= 5 Then
                                    值横类 = "aBZu_多B4"
                                Else
                                    值横类 = "aAZu_多A4"
                                End If
                            Else
                                    值横类 = "aAAu_安A5"
                                    '变为此情况的前导：
                                    '（1）JXZA劫后，站上JA四柱之后；
                                    '（2）JXZB劫后，站上JA四柱且站上JB五柱之后；
                                    '（3）JXAB劫后，JXAB正交四柱之后；
                                    '（4）JXAC劫后，JXAB正交四柱之后；
                                    '（4）JXBC劫后，JXBC正交四柱之后；
                            End If
                            '------------------------------------------------------------
                        End If
            '----------------------------------------------------------------------------
            '反向JC以下
            '----------------------------------------------------------------------------
            ElseIf ARROS(位osBTZC) < 0 Then
                    '--------------------------------------------------------------------
                    '阶段：出
                    '--------------------------------------------------------------------
                    If 值局类 = "4b" Or 值局类 = "4e" Then
                            值横类 = "bCAv_出始"
                    ElseIf 值局类 = "4w" Then
                            值横类 = "bBAv_出始"
                    ElseIf 值局类 = "4v" Then
                            值横类 = "aBZv_出试"
                    '--------------------------------------------------------------------
                    '阶段：继
                    '--------------------------------------------------------------------
                    ElseIf 值局类 = "6u" Or 值局类 = "5i" Then
                            值横类 = "yACv_出继"
                    ElseIf 值局类 = "6h" Or 值局类 = "5I" Then
                            值横类 = IIf(ARROS(位osBTAC) >= -5, "yACv_出继", "yABv_出继")
                    ElseIf 值局类 = "6w" Then
                            值横类 = "yABu_入始"
                    ElseIf 值局类 = "6v" Then
                            值横类 = "zZBu_入试"
                    '--------------------------------------------------------------------
                    '阶段：空
                    '以下针对5c/5d/5e
                    '--------------------------------------------------------------------
                    Else
                            '------------------------------------------------------------
                            If ARROS(位osBTBC) >= -4 Then
                                    值横类 = "zCAv_空始"
                            ElseIf ARROS(位osBTAB) >= -4 Then
                                    值横类 = IIf(ARROS(位osBTAC) >= -9, "zACv_空继", "zABv_空继")
                            '------------------------------------------------------------
                            ElseIf 值局类 = "5e" Then
                                    值横类 = IIf(ARROS(位osBTZB) >= -5, "zZBv_空Be", "zZAv_空Ae")
                            '------------------------------------------------------------
                            '以下状态：5c/5d
                            ElseIf ARROS(位osBTZA) >= -4 Then
                                If ARROS(位osBTZB) >= -5 Then
                                    值横类 = "zZBv_空B4"
                                Else
                                    值横类 = "zZAv_空A4"
                                End If
                            Else
                                    值横类 = "zZZv_安A5"
                            End If
                            '------------------------------------------------------------
                    End If
                    '--------------------------------------------------------------------
            End If
            ARROS(位os基横类) = 值横类
            '============================================================================
'########################################################################################
'########################################################################################
            '============================================================================
            '层类：根据横类进行分类
            '醍醐灌顶20240127：【层类】与【横类】的不同之处，在于将劫的影响范围递延的方法不同，横类按照劫被修复后的时间以防止被诱多，而层类仅注重BTZA。两者可以共存，利用差别相互参考。
            '============================================================================
            值层类 = ""
            '----------------------------------------------------------------------------
            '正向JC以上
            '----------------------------------------------------------------------------
            If ARROS(位osBTZC) > 0 Then
                    '--------------------------------------------------------------------
                    '定义层类：底层是横类
                    '--------------------------------------------------------------------
                    If InStr(值横类, "aAAu") > 0 _
                    Or InStr(值横类, "aAZu") > 0 Then
                            值层类 = 常枚层类G
                    ElseIf InStr(值横类, "aACu") > 0 _
                        Or InStr(值横类, "yAC") > 0 _
                        Or InStr(值横类, "yAB") > 0 _
                        Or InStr(值横类, "zZB") > 0 Then
                            值层类 = 常枚层类A
                    ElseIf InStr(值横类, "aBZu") > 0 _
                        Or InStr(值横类, "aBZv") > 0 Then
                            值层类 = 常枚层类B
                    ElseIf InStr(值横类, "aBAu") > 0 _
                        Or InStr(值横类, "bBA") > 0 Then
                            值层类 = 常枚层类C
                    ElseIf InStr(值横类, "aCAu") > 0 _
