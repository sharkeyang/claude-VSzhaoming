'V1 月策分命查表（几何均值）
'设计思路：命分衡量"金升介入→持有→WXZC<0退出"平均每次能赚多少。
'  几何均值自然惩罚波动，过滤假信号。命分低的股票天然不参与月策略周。
'数据源：_产出物\_工具\vba表月策分命.txt（全量7463只回测生成）
'评分公式：几何均值 = (∏(1+每次收益))^(1/交易次数) - 1
Private 月策分命表 As Object 'Dictionary (代码→月策分命)
Private 月策分命表已加载 As Boolean

'----------------------------------------------------------------------------------------
'加载月策分命CSV，按代码查表赋值
'CSV路径：_产出物\_工具\vba表月策分命.txt，与xlsm同目录
'CSV列：代码,命分,算术均值,最大收益,胜率,交易次数,备注
'----------------------------------------------------------------------------------------
Private Sub IQQQ跨码工具_加载月策分命表()
    If 月策分命表已加载 Then Exit Sub
    Set 月策分命表 = CreateObject("Scripting.Dictionary")

    Dim CSV路径 As String
    CSV路径 = ThisWorkbook.Path & "\_产出物\_工具\vba表月策分命.txt"

    Dim FSO As Object: Set FSO = CreateObject("Scripting.FileSystemObject")
    If Not FSO.FileExists(CSV路径) Then
        月策分命表已加载 = True
        Exit Sub
    End If

    Dim TS As Object: Set TS = FSO.OpenTextFile(CSV路径, 1) '1=ForReading
    Dim 行 As String, 字段 As Variant
    Dim 行号 As Long: 行号 = 0

    Do While Not TS.AtEndOfStream
        行 = TS.ReadLine
        行号 = 行号 + 1
        If 行号 = 1 Then GoTo 下一行 '跳过表头
        字段 = Split(行, vbTab)
        If UBound(字段) >= 1 Then
            '字段0=代码, 字段1=命分
            月策分命表.Add Trim$(字段(0)), CDbl(Trim$(字段(1)))
        End If
下一行:
    Loop
    TS.Close
    月策分命表已加载 = True
End Sub





'由于本sub同时涉及两类程序：一是全息跨代码；二是跨期跨周期同代码。所以最好把跨代码的部分全部拿到全息中去。
'========================================================================================
'========================================================================================
'格式化：计分区域
'========================================================================================
'========================================================================================
Function IQQQ跨码据擎_数程生成跨时神谕( _
          ByRef 谕组 As Variant _
        , ByRef 组结算 As Variant _
        , Optional ByVal 基列 As Integer = 花列甲道 _
        , Optional ByVal 是否跨码 As Boolean = True _
        ) As Integer
'========================================================================================
'设置数组
'========================================================================================
    ReDim Preserve 谕组(LBound(谕组, 1) To UBound(谕组, 1), 1 To 位谕列终全部) As Variant
'========================================================================================
'声明变量
'========================================================================================
    '------------------------------------------------------------------------------------
    '设置基位
    '------------------------------------------------------------------------------------
    Dim 基位日类 As Integer
    基位日类 = 基列 - 1
    Dim 基位周类 As Integer
    基位周类 = 基列 - 1 + 花宽单道 * 1
    Dim 基位月类 As Integer
    基位月类 = 基列 - 1 + 花宽单道 * 2
    '------------------------------------------------------------------------------------
    '声明变量
    '------------------------------------------------------------------------------------
    Dim CIDL As String
    Dim 周类JU#, 周类JV#, 周类JW#
    Dim 日类JU#, 日类JV#, 日类JW#, 日射周类JU#
    Dim 基期周类%, 基期日类%
    Dim 仓位周类#, 仓位日类#
    Dim 周类JZ#, 周类JA#, 周类JB#, 周类JC#, 周类JD#, 周类JE#
    Dim 日类JZ#, 日类JA#, 日类JB#, 日类JC#, 日类JD#, 日类JE#, 日类JF#, 日类JG#
    Dim 值月基月局$
    Dim 值周基月局$, 值周基周局$
    Dim 值日基月局$, 值日基周局$, 值日基日局$
    '------------------------------------------------------------------------------------
    Dim 程隔 As String
    程隔 = String(63, "-") & vbCrLf
    Dim X As Integer, Y As Integer
    Dim i As Integer
    Dim countV As Integer, countW As Integer
    Dim 值层地型 As String
'========================================================================================
'遍历
'========================================================================================
For X = LBound(组结算, 1) To UBound(组结算, 1)
'@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
'============================================================================
'清空原有数据，将每个赋值语句设置空值集中于此
'============================================================================
For Y = 位谕列始全部 To 位谕列终全部
    谕组(X, Y) = ""
Next
CIDL = 组结算(X, 基位日类 + 位os代码)
If UBCID是代码(CIDL) = True Then
'########################################################################################
'########################################################################################
'宏观衍生：段系
'########################################################################################
'########################################################################################
            '============================================================================
            '重组：日波龄BT
            '============================================================================
            谕组(X, 位谕of日波龄BTPRb) = 组结算(X, 基位日类 + 位osBTPRb)
            谕组(X, 位谕of日波龄BTPR0) = 组结算(X, 基位日类 + 位osBTPR0)
            谕组(X, 位谕of日波龄BTPR1) = 组结算(X, 基位日类 + 位osBTPR1)
            谕组(X, 位谕of日波龄BTPR3) = 组结算(X, 基位日类 + 位osBTPR3)
