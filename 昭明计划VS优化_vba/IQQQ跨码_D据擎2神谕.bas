            '============================================================================
            '日周联动
            '注20240911：周日联动的纽带是WJA，根据【周层阶段】【WJA柱排列】【DJCBA】设置。
            '注20250409：只按照属于周类范围时，按WJA进行分类，并仅按照【WJA→DJC】作为周日联合的纽带。
            '注20250409：【不要轻易更改】核心思想就是行动要慢，不要以日线为准冲动押注，要以周线为基准，在周线允许的情况下，再按日线进行操作。
            '注20260425：限制范围：①WXCD＞0（一定要舍弃WXCD＜0）；②WJC之上；③WXAB＞0；④WXZB＞0；
            '注20260726：日周联动：四合一  周向+临幅/日向+操作  如"升矮/升持"
            '          周向:升/待/降  临幅:冲/零/深/浅/矮  日向:升/跌/盘  操作:减/清/持/等/观
            '============================================================================
            谕组(X, 位谕of日层联动) = ""

            '位1：周方向
            Dim 周向 As String
            If 周类BTZC > 0 Then
                If InStr(谕组(X, 位谕of周层护型), "甲") > 0 _
                Or InStr(谕组(X, 位谕of周层护型), "乙") > 0 _
                Or InStr(谕组(X, 位谕of周层护型), "己") > 0 Then
                    周向 = "升"
                Else
                    周向 = "待"
                End If
            Else    'WXZC≤0
                If InStr(谕组(X, 位谕of周层护型), "甲") > 0 _
                Or InStr(谕组(X, 位谕of周层护型), "乙") > 0 _
                Or InStr(谕组(X, 位谕of周层护型), "己") > 0 Then
                    周向 = "待"
                Else
                    周向 = "降"
                End If
            End If

            '位2：临幅（本周初已实现涨跌幅）
            Dim 临幅 As String
            Dim 周临涨幅 As Double, 周临高幅 As Double
            If VBA.IsNumeric(谕组(X, 位谕of周波临涨幅)) Then
                周临涨幅 = 谕组(X, 位谕of周波临涨幅)
                周临高幅 = 谕组(X, 位谕of周波临高幅)
            Else
                周临涨幅 = 0: 周临高幅 = 0
            End If
            If 周临高幅 >= 3 Then
                临幅 = "冲"
            ElseIf 周临高幅 < 0 Then
                临幅 = "零"
            ElseIf 周临涨幅 <= -3 Then
                临幅 = "深"
            ElseIf 周临涨幅 < 0 Then
                临幅 = "浅"
            Else
                临幅 = "矮"
            End If

            '位3：日方向
            Dim 日向 As String
            If 日类BTZE > 0 And 日类BTZC > 0 And 日类BTCD > 0 And 周临涨幅 >= 0 Then
                日向 = "升"
            ElseIf 日类BTZE <= 0 Or 日类BTZC <= 0 Or 周临涨幅 < 0 Then
                日向 = "跌"
            Else
                日向 = "盘"
            End If

            '位4：操作（由前三位推导）
            Dim 操作 As String
            If 周向 = "升" Then
                If 临幅 = "冲" Then
                    If 日向 = "升" Then 操作 = "减" Else 操作 = "清"
                ElseIf 临幅 = "零" Or 临幅 = "深" Or 临幅 = "浅" Then
                    If 日向 = "升" Then 操作 = "持" Else 操作 = "等"
                Else '矮
                    If 日向 = "升" Then 操作 = "持" Else 操作 = "等"
                End If
            ElseIf 周向 = "降" And 临幅 = "深" And 日向 = "跌" Then
                操作 = "清"
            Else
                操作 = "观"
            End If

            '组合输出
            谕组(X, 位谕of日层联动) = 周向 & 临幅 & "/" & 日向 & 操作
            '============================================================================
