                                End If
                        '-----------------------------------------------------
                        '筛选：丘启DE劫DC〇
                        Else
                                If 谕组(X, 位谕of周奏数DE叉CB) < -1 Then
                                    谕组(X, 位谕of周奏丘) = "启DE【DC〇CB多】"
                                ElseIf 谕组(X, 位谕of周奏数DE叉CB) = -1 Then
                                    谕组(X, 位谕of周奏丘) = "启DE【DC〇CB一】"
                                Else
                                    谕组(X, 位谕of周奏丘) = "启DE【DC〇CB〇】"
                                End If
                        End If
                        '-----------------------------------------------------
                End If
            End If
